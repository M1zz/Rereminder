# 앱별 fastlane 설정 — 이 파일이 이 앱의 배포 설정 전부다.
FASTLANE_SHARED_DIR=/Users/hyunholee/Documents/workspace/fastlane-shared
SCHEME=Rereminder

# 선택: 빌드 번호를 xcconfig 로 관리하는 앱만 (예: Version.xcconfig)
VERSION_XCCONFIG=Version.xcconfig

# 선택: 배포 전 게이트 스크립트 (실패하면 배포 중단)
#PREDEPLOY_SCRIPT=scripts/predeploy.sh

# 선택: fastlane/metadata 폴더를 관리하면 false 로 (deliver download_metadata 로 받아오기)
#SKIP_METADATA=true

# 선택: 심사 제출 없이 업로드만 하려면 false
#SUBMIT_FOR_REVIEW=true
