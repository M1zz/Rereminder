         </BuildableReference>
      </BuildableProductRunnable>
      <EnvironmentVariables>
         <!--
            App Clip 은 "URL 로 열린 앱"이라 그냥 실행하면 호출 URL 이 없다.
            Xcode 는 이 값을 실제 초대 URL 처럼 넘겨준다 — 시뮬레이터·기기 모두에서
            QR·배너 없이 클립을 그대로 띄워 볼 수 있다. (?minutes=N 으로 시작 시간 지정, 1~120)
         -->
         <EnvironmentVariable
            key = "_XCAppClipURL"
            value = "https://m1zz.github.io/rereminder/?minutes=30"
            isEnabled = "YES">
         </EnvironmentVariable>
      </EnvironmentVariables>
   </LaunchAction>
