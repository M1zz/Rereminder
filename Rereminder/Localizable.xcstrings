    "Track your timer usage patterns\nand improve your time management" : {
      "comment" : "History locked description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte, jak časovače používáte,\na zlepšete si hospodaření s časem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg, hvordan du bruger timere,\nog bliv bedre til at styre din tid"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge, wie du Timer nutzt,\nund verbessere dein Zeitmanagement"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε πώς χρησιμοποιείτε τον χρονομετρητή\nκαι διαχειριστείτε καλύτερα τον χρόνο σας"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa cómo usas el temporizador\ny mejora tu gestión del tiempo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa, miten käytät ajastimia,\nja paranna ajanhallintaasi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez vos habitudes d’utilisation\net améliorez votre gestion du temps"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lacak pola pemakaian timer Anda\ndan tingkatkan manajemen waktu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri come usi i timer\ne migliora la gestione del tempo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーの使用パターンを把握して\n時間管理を改善しましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머 사용 패턴을 확인하고\n시간 관리를 개선하세요"
