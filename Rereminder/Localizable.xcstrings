    "guide_watch_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell die Dauer mit der Digital Crown ein und starte einen Timer auch ohne iPhone in der Nähe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the duration with the Digital Crown and start a timer without your iPhone nearby."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la duración con la Digital Crown e inicia un temporizador sin tener el iPhone cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez la durée avec la Digital Crown et lancez un minuteur sans votre iPhone à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la durata con la Digital Crown e avvia un timer anche senza iPhone vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneがなくても Digital Crown で時間を設定してタイマーを開始できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone이 없어도 Digital Crown으로 시간을 정하고 타이머를 시작하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a duração com a Digital Crown e inicie um timer sem o iPhone por perto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用数码表冠设定时长，身边没有 iPhone 也能开始计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用數位錶冠設定時長，身邊沒有 iPhone 也能開始計時。"
          }
        }
      }
    },
