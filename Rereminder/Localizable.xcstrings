    "tip_multidevice_message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder also works on Apple Watch, widgets, Siri, and Mac. Tap here to see how."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder は Apple Watch、ウィジェット、Siri、Mac でも使えます。タップして活用法を確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두번알림은 Apple Watch, 위젯, Siri, Mac에서도 쓸 수 있어요. 눌러서 활용법을 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder 在 Apple Watch、小组件、Siri 和 Mac 上也能用。点按这里看看怎么用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder 在 Apple Watch、小工具、Siri 和 Mac 上也能用。點一下這裡看看怎麼用。"
          }
        }
      }
    },
    "tip_multidevice_title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use it everywhere"
          }
        },
