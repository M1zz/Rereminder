        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farklı günlerde %1$@, %2$lld uyarı kullandın. Pro bunu hatırlar, böylece bir dahaki sefere kadranda hazır olur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã chạy %1$@ với %2$lld chuông báo vào nhiều ngày khác nhau. Pro ghi nhớ cài đặt này, nên lần sau nó đã nằm sẵn trên mặt số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在不同的日子里都用了 %1$@、%2$lld 个提醒。Pro 会记住这组设置，下次打开时就已经放在表盘上。"
          }
