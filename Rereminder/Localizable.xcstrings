    "On iPhone, open the Watch app → My Watch, and install Rereminder if it isn't there." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのWatchアプリ →「マイウォッチ」でRereminderがなければインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 Watch 앱 → 내 시계에서 두번알림이 없으면 설치하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上打开“Watch”App →“我的手表”，如果没有 Rereminder 就安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上開啟「Watch」App →「我的手錶」，如果沒有 Rereminder 就安裝它。"
          }
        }
      }
    },
    "onboarding_desc_7" : {
      "comment" : "Onboarding page 7 description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start on iPhone and keep going on Apple Watch or Mac — pause on one, and the others follow. Widgets and the Dynamic Island let you check and control without opening the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで始めてApple WatchやMacでそのまま続けられます。片方で止めればもう片方も止まります。ウィジェットやダイナミックアイランドからは、アプリを開かずに確認・操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 시작해 Apple Watch나 Mac에서 그대로 이어가세요. 한쪽에서 멈추면 다른 쪽도 따라 멈춥니다. 위젯과 다이나믹 아일랜드로는 앱을 열지 않고도 보고 조작할 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上开始，在 Apple Watch 或 Mac 上接着用 — 一边暂停，另一边也跟着停。用小组件和灵动岛，不打开 App 也能查看和操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上開始，在 Apple Watch 或 Mac 上接著用 — 一邊暫停，另一邊也跟著停。用小工具和動態島，不開啟 App 也能查看和操作。"
          }
        }
      }
    },
    "onboarding_scenario_7" : {
      "comment" : "Onboarding page 7 example",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenting from your Mac while your wrist taps the 5-minute warning"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macで発表しながら、5分前の通知は手首で受け取る"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
