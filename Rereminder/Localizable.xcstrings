    "We'll remind you the evening before, with this setup ready to go." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomeneme se večer předem a toto nastavení bude připravené."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi minder dig om det aftenen før, med denne opsætning klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erinnern dich am Vorabend – mit diesem Setup startklar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σας το θυμίσουμε το προηγούμενο βράδυ, με αυτή τη ρύθμιση έτοιμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisaremos la noche anterior, con esta configuración lista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistutamme edellisenä iltana, ja nämä asetukset ovat valmiina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous le rappellerons la veille au soir, avec ce réglage prêt à l’emploi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan mengingatkan Anda malam sebelumnya, dengan pengaturan ini siap dipakai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te lo ricorderemo la sera prima, con questa configurazione già pronta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その前日の夕方にお知らせします。今の設定はそのまま用意しておきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 전날 저녁에 알려 드릴게요. 지금 설정 그대로 준비해 둡니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi minner deg på det kvelden før, med dette oppsettet klart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We herinneren je de avond ervoor, met deze setup klaar voor gebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnimy Ci wieczorem dzień wcześniej, z tą konfiguracją gotową do startu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos avisar você na véspera, à noite, com esta configuração pronta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisamos na véspera à noite, com esta configuração pronta a usar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напомним накануне вечером — с этой настройкой наготове."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi påminner dig kvällen innan, med det här upplägget redo att köra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะเตือนคุณในตอนเย็นก่อนวันนั้น พร้อมชุดตั้งค่านี้ที่เตรียมไว้ให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir önceki akşam, bu ayar hazır bekliyor olacak şekilde sana hatırlatacağız."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi sẽ nhắc bạn vào tối hôm trước, với cài đặt này đã sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会在前一天晚上提醒你，并把现在的设置准备好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們會在前一天晚上提醒你，並把現在的設定準備好。"
          }
        }
      }
    },
