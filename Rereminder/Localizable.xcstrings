    "Swipe up or down to adjust the time. Double tap to enter an exact time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach oben oder unten wischen, um die Zeit anzupassen. Doppeltippen, um eine genaue Zeit einzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o abajo para ajustar el tiempo. Toca dos veces para escribir un tiempo exacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le haut ou le bas pour régler la durée. Touchez deux fois pour saisir une durée précise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri in su o in giù per regolare il tempo. Tocca due volte per inserire un tempo preciso."
