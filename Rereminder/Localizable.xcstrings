        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har indstillet %1$@ med %2$lld påmindelser manuelt igen. Pro holder det på urskiven for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %1$@ mit %2$lld Erinnerungen wieder von Hand eingestellt. Pro behält es für dich auf dem Zifferblatt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίσατε ξανά με το χέρι %1$@ με %2$lld ειδοποιήσεις. Το Pro το κρατά στο καντράν για εσάς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You set %1$@ with %2$lld alerts again by hand. Pro keeps it on the dial for you."
