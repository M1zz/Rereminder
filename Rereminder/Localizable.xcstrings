    "Notifications are off, so nothing rings once the screen is off." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznámení jsou vypnutá, takže po zhasnutí displeje nic nezazvoní."
