    "tip_presentation_message" : {
      "comment" : "TipKit: presentation mode detail",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teil die Zeit im Session-Modus in Abschnitte – bei jedem Wechsel wirst du erinnert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Session mode, split the time into parts — you'll be told at every change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Modo sesión, divide el tiempo en partes y te avisará en cada cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode Séance, découpez le temps en parties : vous serez prévenu à chaque changement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In modalità Sessione dividi il tempo in parti: ti avviserà a ogni cambio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションモードで導入・本編・まとめのように時間を分けると、区間が変わるたびに知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 모드로 도입·본론·마무리처럼 시간을 나누면, 구간이 바뀔 때마다 알려줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Modo Sessão, divida o tempo em partes — você é avisado a cada mudança."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用分段模式把时间分成几段，每次切换都会提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用分段模式把時間分成幾段，每次切換都會提醒你。"
          }
        }
      }
    },
