    "One buzz is easy to miss. Rereminder repeats the end alert until you tap Stop or Snooze." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedno zavibrování snadno přehlédnete. Rereminder závěrečné upozornění opakuje, dokud neklepnete na Zastavit nebo Odložit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én vibration er nem at overse. Rereminder gentager slutsignalet, til du trykker på Stop eller Slumre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Vibrieren verpasst man leicht. Rereminder wiederholt das Schlusssignal, bis du auf Stopp oder Schlummern tippst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία δόνηση ξεφεύγει εύκολα. Το Rereminder επαναλαμβάνει την ειδοποίηση λήξης μέχρι να πατήσετε Διακοπή ή Αναβολή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vibración se pasa por alto fácilmente. Rereminder repite el aviso final hasta que toques Detener o Posponer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi värinä menee helposti ohi. Rereminder toistaa loppumerkkiä, kunnes napautat Pysäytä tai Torkku."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule vibration passe facilement inaperçue. Rereminder répète l’alerte de fin jusqu’à ce que vous touchiez Arrêter ou Répéter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu getaran mudah terlewat. Rereminder mengulang peringatan akhir sampai Anda mengetuk Hentikan atau Tunda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vibrazione è facile da perdere. Rereminder ripete l'avviso di fine finché non tocchi Stop o Posponi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度の振動は見逃しやすいものです。停止かスヌーズを押すまで終了通知をくり返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번의 진동은 놓치기 쉽습니다. 정지나 다시 알림을 누를 때까지 종료 알림을 반복합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én vibrasjon er lett å overse. Rereminder gjentar sluttvarselet til du trykker på Stopp eller Slumre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén trilling mis je snel. Rereminder herhaalt het eindsignaal tot je op Stop of Sluimer tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedną wibrację łatwo przegapić. Rereminder powtarza sygnał końca, dopóki nie stukniesz Zatrzymaj lub Drzemka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vibração é fácil de perder. O Rereminder repete o alerta final até você tocar em Parar ou Adiar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vibração passa facilmente despercebida. O Rereminder repete o alerta final até tocar em Parar ou Adiar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одну вибрацию легко пропустить. Rereminder повторяет финальный сигнал, пока вы не нажмёте «Стоп» или «Отложить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vibration är lätt att missa. Rereminder upprepar slutsignalen tills du trycker på Stopp eller Snooza."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสั่นครั้งเดียวพลาดได้ง่าย Rereminder จะเตือนซ้ำเมื่อจบจนกว่าคุณจะแตะหยุดหรือเลื่อนปลุก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir titreşimi kaçırmak kolay. Rereminder, Durdur'a veya Ertele'ye dokunana kadar bitiş uyarısını tekrarlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một lần rung rất dễ bỏ lỡ. Rereminder lặp lại báo kết thúc đến khi bạn chạm Dừng hoặc Báo lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只震一下很容易错过。Rereminder 会重复结束提醒，直到你点按停止或稍后提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只震一下很容易錯過。Rereminder 會重複結束提醒，直到你點一下停止或稍後提醒。"
          }
        }
      }
    },
    "One more set, then cool down — without counting." : {
      "localizations" : {
