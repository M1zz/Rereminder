    "guide_iphone_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte čas na ciferníku a klepnutím na čipy upozornění si nechte připomenout 1, 3, 5 nebo 10 minut před koncem – kolik chcete."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil tiden på urskiven, og tryk på påmindelsesknapperne for at blive påmindet 1, 3, 5 eller 10 minutter før slut – så mange, du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell die Zeit am Zifferblatt ein und tippe auf die Erinnerungs-Chips, um 1, 3, 5 oder 10 Minuten vor Ende erinnert zu werden – so oft du willst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίστε τον χρόνο στο καντράν και πατήστε τα κουμπιά ειδοποιήσεων για υπενθύμιση 1, 3, 5 ή 10 λεπτά πριν από το τέλος — όσες θέλετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the time on the dial, then tap the alert chips to be reminded 1, 3, 5, or 10 minutes before the end — as many as you like."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the time on the dial, then tap the alert chips to be reminded 1, 3, 5, or 10 minutes before the end — as many as you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el tiempo en el dial y toca los chips de aviso para que te avise 1, 3, 5 o 10 minutos antes del final, tantas veces como quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta aika kellotaululla ja napauta muistutuspainikkeita, niin saat muistutuksen 1, 3, 5 tai 10 minuuttia ennen loppua – niin monta kuin haluat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez la durée sur le cadran, puis touchez les puces d’alerte pour être prévenu 1, 3, 5 ou 10 minutes avant la fin, autant de fois que vous voulez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur waktu di dial, lalu ketuk chip peringatan untuk diingatkan 1, 3, 5, atau 10 menit sebelum selesai, sebanyak yang Anda mau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta il tempo sul quadrante, poi tocca i chip degli avvisi per ricevere un promemoria 1, 3, 5 o 10 minuti prima della fine: quanti ne vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイヤルで時間を設定し、アラートチップをタップして終了1・3・5・10分前など好きなだけ事前に通知を受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다이얼에서 시간을 맞춘 뒤 알림 칩을 눌러 종료 1·3·5·10분 전 등 원하는 만큼 미리 알림을 받으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still inn tiden på skiven, og trykk på varselbrikkene for å bli varslet 1, 3, 5 eller 10 minutter før slutt – så mange du vil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel de tijd in op de wijzerplaat en tik op de meldingsknopjes voor een seintje 1, 3, 5 of 10 minuten voor het einde — zoveel als je wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw czas na tarczy, a potem stuknij przyciski alertów, aby dostać przypomnienie 1, 3, 5 lub 10 minut przed końcem – ile tylko chcesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o tempo no mostrador e toque nos chips de alerta para ser avisado 1, 3, 5 ou 10 minutos antes do fim — quantas vezes quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o tempo no mostrador e toque nos alertas para ser avisado 1, 3, 5 ou 10 minutos antes do fim — quantas vezes quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выставьте время на шкале и коснитесь кнопок сигналов, чтобы получить напоминание за 1, 3, 5 или 10 минут до конца — сколько угодно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in tiden på urtavlan och tryck på påminnelseknapparna för att bli påmind 1, 3, 5 eller 10 minuter före slutet – så många du vill."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งเวลาบนหน้าปัด แล้วแตะชิปการแจ้งเตือนเพื่อให้เตือนก่อนจบ 1, 3, 5 หรือ 10 นาที จะตั้งกี่ครั้งก็ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadranda süreyi ayarla, sonra bitişten 1, 3, 5 veya 10 dakika önce haber almak için uyarı çiplerine dokun; istediğin kadar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt thời gian trên mặt số, rồi chạm vào các thẻ báo trước để được nhắc trước khi kết thúc 1, 3, 5 hoặc 10 phút — bao nhiêu tùy thích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在表盘上设定时间，然后点按提醒标签，就能在结束前 1、3、5、10 分钟收到提醒 — 想加几个都可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在錶盤上設定時間，然後點一下提醒標籤，就能在結束前 1、3、5、10 分鐘收到提醒 — 想加幾個都可以。"
          }
        }
      }
    },
