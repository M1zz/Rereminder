    "guide_siri_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte „Spusť časovač Rereminder“ – nebo ho pozastavte, obnovte či zastavte – bez použití rukou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig »Start en Rereminder-timer« – eller sæt på pause, genoptag og stop – helt uden hænder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „Starte einen Rereminder-Timer“ – oder pausiere, setze fort und stoppe – ganz ohne Hände."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πείτε «Ξεκίνα χρονομετρητή Rereminder» — ή παύση, συνέχιση και διακοπή — χωρίς να αγγίξετε τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “Start a Rereminder timer” — or pause, resume, and stop — hands-free."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “Start a Rereminder timer” — or pause, resume, and stop — hands-free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “Inicia un temporizador de Rereminder”, o pausa, reanuda y detén, sin usar las manos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sano ”Käynnistä Rereminder-ajastin” – tai keskeytä, jatka ja pysäytä – käsiä käyttämättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « Lance un minuteur Rereminder », ou mettez en pause, reprenez et arrêtez, sans les mains."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucapkan “Mulai timer Rereminder”, atau jeda, lanjutkan, dan hentikan, tanpa menyentuh apa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' “Avvia un timer Rereminder”, oppure metti in pausa, riprendi e ferma, senza usare le mani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Rereminderタイマーを開始」と話しかけるだけ。一時停止・再開・停止もハンズフリーで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“두번알림 타이머 시작”이라고 말해보세요. 일시정지·재개·정지도 손을 쓰지 않고 가능해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si «Start en Rereminder-tidtaker» – eller sett på pause, fortsett og stopp – helt håndfritt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg ‘Start een Rereminder-timer’ — of pauzeer, hervat en stop — zonder je handen te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz „Uruchom minutnik Rereminder” – albo wstrzymaj, wznów i zatrzymaj – bez użycia rąk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “Iniciar um timer do Rereminder” — ou pausar, retomar e parar — sem usar as mãos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “Iniciar um temporizador do Rereminder” — ou pausar, retomar e parar — sem usar as mãos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите «Запусти таймер Rereminder» — или поставьте на паузу, продолжите, остановите — без рук."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg ”Starta en Rereminder-timer” – eller pausa, återuppta och stoppa – utan att använda händerna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดว่า “เริ่มตัวจับเวลา Rereminder” หรือสั่งหยุดพัก ทำต่อ และหยุด ได้โดยไม่ต้องใช้มือ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Rereminder zamanlayıcısını başlat” de; duraklatmak, sürdürmek ve durdurmak da eller serbest."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói “Bắt đầu hẹn giờ Rereminder” — hoặc tạm dừng, tiếp tục và dừng — mà không cần dùng tay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说一句“开始 Rereminder 计时”就行 — 暂停、继续、停止也都不用动手。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說一句「開始 Rereminder 計時」就行 — 暫停、繼續、停止也都不用動手。"
          }
        }
      }
    },
