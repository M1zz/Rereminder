    "VoiceOver reads every timer and button, in the right order." : {
      "comment" : "Roadmap item detail: VoiceOver",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver přečte každý časovač i tlačítko ve správném pořadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VoiceOver læser alle timere og knapper op i den rigtige rækkefølge."
