            "value" : "Un temporizador,\nen todos tus dispositivos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un minuteur,\ntous vos appareils"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un timer,\ntutti i tuoi dispositivi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとつのタイマーを\nすべてのデバイスで"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머 하나로\n모든 기기에서"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um timer,\ntodos os seus dispositivos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个计时器，\n你的所有设备"
          }
        },
        "zh-Hant" : {
