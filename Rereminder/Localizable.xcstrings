            "state" : "translated",
            "value" : "Chạy độc lập"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可独立运行"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可獨立運作"
          }
        }
      }
    },
    "guide_watch_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spusťte, pozastavte nebo zastavte časovač na jednom zařízení a druhé se přizpůsobí – i na pozadí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, sæt på pause eller stop på den ene enhed, så følger den anden med – også i baggrunden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte, pausiere oder stoppe auf einem Gerät, und das andere zieht mit – auch im Hintergrund."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε, κάντε παύση ή σταματήστε σε μία συσκευή και ενημερώνεται και η άλλη — ακόμα και στο παρασκήνιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, pause, or stop on one device and it updates on the other — even in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia, pausa o detén en un dispositivo y se actualiza en el otro, incluso en segundo plano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistä, keskeytä tai pysäytä yhdellä laitteella, niin toinen seuraa perässä – myös taustalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez, mettez en pause ou arrêtez sur un appareil, et l’autre suit, même en arrière-plan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai, jeda, atau hentikan di satu perangkat, perangkat lain ikut diperbarui, bahkan di latar belakang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia, metti in pausa o ferma su un dispositivo e l'altro si aggiorna, anche in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片方のデバイスで開始・一時停止・停止すると、バックグラウンドでももう片方に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한쪽 기기에서 시작·일시정지·정지하면 백그라운드에서도 다른 기기에 그대로 반영돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, sett på pause eller stopp på én enhet, så oppdateres den andre – også i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, pauzeer of stop op het ene apparaat en het andere volgt — zelfs op de achtergrond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchom, wstrzymaj lub zatrzymaj na jednym urządzeniu, a drugie od razu się dostosuje – nawet w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie, pause ou pare em um dispositivo e o outro é atualizado — mesmo em segundo plano."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie, pause ou pare num dispositivo e o outro é atualizado — mesmo em segundo plano."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запустите, поставьте на паузу или остановите на одном устройстве — и другое обновится, даже в фоне."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta, pausa eller stoppa på en enhet så uppdateras den andra – även i bakgrunden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่ม หยุดพัก หรือหยุดบนอุปกรณ์หนึ่ง อีกเครื่องก็อัปเดตตาม แม้ทำงานอยู่เบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir aygıtta başlat, duraklat ya da durdur; diğeri de güncellenir, arka planda bile."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu, tạm dừng hoặc dừng trên một thiết bị, thiết bị kia sẽ cập nhật theo — kể cả khi chạy nền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一台设备上开始、暂停或停止，另一台也会跟着更新 — 即使在后台也一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一台裝置上開始、暫停或停止，另一台也會跟著更新 — 即使在背景也一樣。"
          }
        }
      }
    },
