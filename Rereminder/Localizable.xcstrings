    "guide_watch_f3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při každém upozornění předem i na konci ucítíte jemné klepnutí na zápěstí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mærk et blidt prik på håndleddet ved hvert forvarsel, og når timeren slutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spür bei jeder Vorwarnung und am Ende ein sanftes Tippen am Handgelenk."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Νιώστε ένα απαλό χτύπημα στον καρπό σε κάθε προειδοποίηση και όταν λήξει ο χρονομετρητής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feel a gentle tap on your wrist at each pre-alert time and when the timer ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siente un toque suave en la muñeca en cada aviso previo y cuando termina el temporizador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunne kevyt napautus ranteessasi jokaisen ennakkomuistutuksen kohdalla ja ajastimen päättyessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentez un léger toucher au poignet à chaque pré-alerte et à la fin du minuteur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rasakan ketukan lembut di pergelangan tangan setiap waktu peringatan awal dan saat timer berakhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senti un leggero tocco al polso a ogni preavviso e alla fine del timer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各事前アラートの時刻とタイマー終了時に手首の触覚で知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 미리 알림 시점과 타이머 종료 때 손목에 진동으로 알려줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjenn et lett trykk på håndleddet ved hvert forvarsel og når tidtakeren er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voel een zacht tikje op je pols bij elke voorwaarschuwing en wanneer de timer afloopt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczuj delikatne stuknięcie na nadgarstku przy każdym ostrzeżeniu i na koniec."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta um toque suave no pulso a cada pré-alerta e quando o timer termina."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta um toque suave no pulso em cada pré-alerta e quando o temporizador termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лёгкое касание на запястье при каждом предупреждении и в конце таймера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känn en lätt knackning på handleden vid varje förvarning och när timern tar slut."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รู้สึกถึงการแตะเบาๆ ที่ข้อมือทุกครั้งที่ถึงเวลาแจ้งเตือนล่วงหน้าและเมื่อตัวจับเวลาจบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ön uyarıda ve zamanlayıcı bittiğinde bileğinde hafif bir dokunuş hisset."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảm nhận một cú chạm nhẹ trên cổ tay ở mỗi lần báo trước và khi hẹn giờ kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个提前提醒时刻和计时结束时，手腕上都会轻轻震动提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個提前提醒時刻和計時結束時，手腕上都會輕輕震動提示。"
          }
        }
      }
    },
