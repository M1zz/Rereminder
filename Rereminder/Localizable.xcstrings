    "tip_template_message" : {
      "comment" : "TipKit: save template detail",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte si čas a upozornění, které jste právě nastavili, a příště stejný časovač spustíte jedním klepnutím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem den tid og de påmindelser, du lige har indstillet, og start den samme timer med ét tryk næste gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere Zeit und Erinnerungen, die du gerade eingestellt hast, und starte denselben Timer nächstes Mal mit einem Tipp."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύστε τον χρόνο και τις ειδοποιήσεις που μόλις ορίσατε και ξεκινήστε τον ίδιο χρονομετρητή με ένα άγγιγμα την επόμενη φορά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the time and alerts you just set, and start the same timer with one tap next time."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the time and alerts you just set, and start the same timer with one tap next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el tiempo y los avisos que acabas de ajustar y, la próxima vez, inicia el mismo temporizador con un toque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallenna juuri asettamasi aika ja muistutukset, niin käynnistät saman ajastimen ensi kerralla yhdellä napautuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez la durée et les alertes que vous venez de régler, et relancez le même minuteur d’un toucher la prochaine fois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan waktu dan peringatan yang baru Anda atur, lalu mulai timer yang sama dengan sekali ketuk lain kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva il tempo e gli avvisi che hai appena impostato e la prossima volta avvia lo stesso timer con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま設定した時間と通知を保存しておくと、次回はワンタップで同じタイマーを開始できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 맞춘 시간과 알림을 저장해 두면, 다음엔 한 번에 같은 타이머를 시작할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre tiden og varslene du nettopp stilte inn, og start den samme tidtakeren med ett trykk neste gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar de tijd en meldingen die je net hebt ingesteld, en start de volgende keer dezelfde timer met één tik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz ustawiony właśnie czas i alerty, a następnym razem uruchomisz ten sam minutnik jednym stuknięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve o tempo e os alertas que você acabou de definir e inicie o mesmo timer com um toque da próxima vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde o tempo e os alertas que acabou de definir e inicie o mesmo temporizador com um toque da próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните время и сигналы, которые только что выставили, и в следующий раз запускайте такой же таймер одним касанием."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara tiden och påminnelserna du just ställt in, och starta samma timer med ett tryck nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกเวลาและการแจ้งเตือนที่เพิ่งตั้ง แล้วครั้งหน้าก็เริ่มตัวจับเวลาเดิมได้ในแตะเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az önce ayarladığın süreyi ve uyarıları kaydet, bir dahaki sefere aynı zamanlayıcıyı tek dokunuşla başlat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu thời gian và chuông báo bạn vừa đặt, lần sau chỉ cần một chạm để chạy lại hẹn giờ đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存刚设好的时间和提醒，下次点一下就能开始同样的计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存剛設好的時間和提醒，下次點一下就能開始同樣的計時。"
          }
        }
      }
    },
