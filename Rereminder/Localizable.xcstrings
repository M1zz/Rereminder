    "Run a talk or class section by section, each with its own time" : {
      "comment" : "Paywall showcase detail",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veďte přednášku nebo hodinu po částech, každou s vlastním časem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold et oplæg eller en time afsnit for afsnit, hvert med sin egen tid"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte Vorträge oder Kurse Abschnitt für Abschnitt, jeder mit eigener Zeit"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάνε μια ομιλία ή ένα μάθημα ανά ενότητα, καθεμία με τον χρόνο της"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run a talk or class section by section, each with its own time"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da una charla o clase por secciones, cada una con su tiempo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä esitys tai tunti osa kerrallaan, jokaisella oma aikansa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menez un exposé ou un cours par sections, chacune avec son temps"
