    },
    "With Pro, the app keeps setups like this and brings them back in one tap." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S Pro si aplikace taková nastavení pamatuje a vrátí je jedním klepnutím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Pro gemmer appen opsætninger som denne og henter dem frem med ét tryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Pro merkt sich die App solche Setups und holt sie mit einem Tipp zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με το Pro, η εφαρμογή κρατά τέτοιες ρυθμίσεις και τις επαναφέρει με ένα άγγιγμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Pro, la app guarda configuraciones como esta y las recupera con un toque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prolla appi säilyttää tällaiset asetukset ja palauttaa ne yhdellä napautuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Pro, l’app garde ce genre de réglage et le ramène d’un toucher."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan Pro, app menyimpan pengaturan seperti ini dan memunculkannya lagi dengan sekali ketuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Pro, l'app conserva configurazioni come questa e le richiama con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proでは、こうした設定をそのまま保存してワンタップで呼び出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro에서는 이런 설정을 저장해 두고 한 번에 불러올 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Pro husker appen oppsett som dette og henter dem frem med ett trykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Pro onthoudt de app setups zoals deze en haal je ze met één tik terug."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z Pro aplikacja zapamiętuje takie konfiguracje i przywraca je jednym stuknięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o Pro, o app guarda configurações como esta e as traz de volta com um toque."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o Pro, a app guarda configurações como esta e repõe-nas com um toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
