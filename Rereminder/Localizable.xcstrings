    },
    "tip_presentation_message" : {
      "comment" : "TipKit: presentation mode detail",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Session mode, split the time into parts — you'll be told at every change."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションモードで導入・本編・まとめのように時間を分けると、区間が変わるたびに知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 모드로 도입·본론·마무리처럼 시간을 나누면, 구간이 바뀔 때마다 알려줍니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用分段模式把时间分成几段，每次切换都会提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用分段模式把時間分成幾段，每次切換都會提醒你。"
          }
        }
      }
    },
    "tip_presentation_title" : {
      "comment" : "TipKit: presentation mode discovery",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split a long session into sections"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長いセッションは区間に分けてみましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴 세션은 구간으로 나눠 보세요"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把长时间的场次分成几段"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把長時間的場次分成幾段"
          }
        }
      }
    },
    "tip_template_message" : {
      "comment" : "TipKit: save template detail",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the time and alerts you just set, and start the same timer with one tap next time."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま設定した時間と通知を保存しておくと、次回はワンタップで同じタイマーを開始できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 맞춘 시간과 알림을 저장해 두면, 다음엔 한 번에 같은 타이머를 시작할 수 있어요."
          }
