    "guide_mac_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte odpočet v řádku nabídek a pozastavte, obnovte nebo zastavte ho, aniž byste přerušili práci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg nedtællingen i menulinjen, og sæt på pause, genoptag eller stop uden at forlade dit arbejde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh den Countdown in der Menüleiste und pausiere, setze fort oder stoppe, ohne deine Arbeit zu verlassen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε την αντίστροφη μέτρηση στη γραμμή μενού και κάντε παύση, συνέχιση ή διακοπή χωρίς να αφήσετε τη δουλειά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch the countdown in the menu bar and pause, resume, or stop without leaving your work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira el tiempo restante en la barra de menús y pausa, reanuda o detén sin dejar lo que estás haciendo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa lähtölaskentaa valikkorivillä ja keskeytä, jatka tai pysäytä poistumatta työsi äärestä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez le compte à rebours dans la barre des menus et mettez en pause, reprenez ou arrêtez sans quitter votre travail."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat hitung mundur di bar menu, lalu jeda, lanjutkan, atau hentikan tanpa meninggalkan pekerjaan Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda il conto alla rovescia nella barra dei menu e metti in pausa, riprendi o ferma senza lasciare il lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーで残り時間を見ながら、作業を中断せずに一時停止・再開・停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대에서 남은 시간을 보고 작업을 멈추지 않고 일시정지·재개·정지하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg nedtellingen i menylinjen, og sett på pause, fortsett eller stopp uten å forlate det du jobber med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg het aftellen in de menubalk en pauzeer, hervat of stop zonder je werk te onderbreken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obserwuj odliczanie na pasku menu i wstrzymuj, wznawiaj lub zatrzymuj bez odrywania się od pracy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe a contagem na barra de menus e pause, retome ou pare sem sair do que está fazendo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe a contagem na barra de menus e pause, retome ou pare sem sair do que está a fazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следите за отсчётом в строке меню и ставьте на паузу, продолжайте или останавливайте, не отрываясь от работы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se nedräkningen i menyraden och pausa, återuppta eller stoppa utan att lämna det du håller på med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูเวลานับถอยหลังบนแถบเมนู และหยุดพัก ทำต่อ หรือหยุดได้โดยไม่ต้องละจากงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri sayımı menü çubuğunda izle; işini bırakmadan duraklat, sürdür ya da durdur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem đếm ngược trên thanh menu và tạm dừng, tiếp tục hoặc dừng mà không phải rời công việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏看剩余时间，不用离开手上的工作就能暂停、继续或停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列看剩餘時間，不用離開手上的工作就能暫停、繼續或停止。"
          }
        }
      }
    },
