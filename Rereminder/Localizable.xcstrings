    "guide_iphone_f3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiere, setze fort oder stoppe den Timer direkt in der Dynamic Island oder auf dem Sperrbildschirm – ohne die App zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, resume, or stop the timer right from the Dynamic Island or Lock Screen — no need to open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa, reanuda o detén el temporizador desde la Dynamic Island o la pantalla bloqueada, sin abrir la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez en pause, reprenez ou arrêtez le minuteur depuis la Dynamic Island ou l’écran verrouillé, sans ouvrir l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa, riprendi o ferma il timer direttamente da Dynamic Island o dalla schermata di blocco, senza aprire l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを開かずに Dynamic Island やロック画面から一時停止・再開・停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 열지 않아도 다이나믹 아일랜드나 잠금 화면에서 바로 일시정지·재개·정지할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, retome ou pare o timer direto na Dynamic Island ou na Tela Bloqueada — sem abrir o app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
