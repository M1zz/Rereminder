    "Pick one and we'll set the timer up for you. You can change everything later." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte si a my časovač nastavíme za vás. Vše můžete později změnit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en, så sætter vi timeren op for dig. Du kan ændre det hele senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl etwas aus, und wir richten den Timer für dich ein. Du kannst später alles ändern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαλέξτε ένα και θα ρυθμίσουμε τον χρονομετρητή για εσάς. Μπορείτε να αλλάξετε τα πάντα αργότερα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige uno y configuramos el temporizador por ti. Puedes cambiarlo todo después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse yksi, niin asetamme ajastimen valmiiksi. Voit muuttaa kaikkea myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez-en un et nous réglerons le minuteur pour vous. Vous pourrez tout modifier ensuite."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih salah satu, kami akan menyiapkan timernya untuk Anda. Semuanya bisa diubah nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegline uno e configuriamo il timer per te. Puoi cambiare tutto dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとつ選べばタイマーを用意します。あとからいくらでも変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하나 고르시면 타이머를 맞춰 드릴게요. 나중에 얼마든지 바꿀 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg ett, så stiller vi inn tidtakeren for deg. Du kan endre alt senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies er een en wij stellen de timer voor je in. Je kunt later alles aanpassen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz jedno, a ustawimy minutnik za Ciebie. Wszystko możesz później zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma opção e configuramos o timer para você. Dá para mudar tudo depois."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma opção e configuramos o temporizador por si. Pode mudar tudo mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите вариант, и мы настроим таймер за вас. Всё можно поменять потом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ett alternativ så ställer vi in timern åt dig. Du kan ändra allt senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกหนึ่งอย่าง แล้วเราจะตั้งตัวจับเวลาให้ เปลี่ยนทุกอย่างได้ภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birini seç, zamanlayıcıyı senin için kuralım. Her şeyi sonra değiştirebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn một mục và chúng tôi sẽ thiết lập hẹn giờ cho bạn. Bạn có thể thay đổi mọi thứ sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选一个，我们帮你把计时器配好。之后随时可以改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選一個，我們幫你把計時器配好。之後隨時可以改。"
          }
        }
      }
    },
