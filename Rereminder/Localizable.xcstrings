    "On iPhone, open the Watch app → My Watch, and install Rereminder if it isn't there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf dem iPhone die Watch-App → Meine Uhr und installiere Rereminder, falls es fehlt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el iPhone, abre la app Watch → Mi reloj e instala Rereminder si no aparece."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’iPhone, ouvrez l’app Watch → Ma montre, et installez Rereminder s’il n’y est pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPhone, apri l'app Watch → Il mio orologio e installa Rereminder se non c'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのWatchアプリ →「マイウォッチ」でRereminderがなければインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 Watch 앱 → 내 시계에서 두번알림이 없으면 설치하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPhone, abra o app Watch → Meu Relógio e instale o Rereminder se ele não estiver lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上打开“Watch”App →“我的手表”，如果没有 Rereminder 就安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上開啟「Watch」App →「我的手錶」，如果沒有 Rereminder 就安裝它。"
          }
        }
      }
    },
    "onboarding_desc_7" : {
      "comment" : "Onboarding page 7 description",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte auf dem iPhone und mach auf Apple Watch oder Mac weiter – pausierst du auf einem Gerät, folgen die anderen. Mit Widgets und der Dynamic Island siehst und steuerst du alles, ohne die App zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start on iPhone and keep going on Apple Watch or Mac — pause on one, and the others follow. Widgets and the Dynamic Island let you check and control without opening the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza en el iPhone y sigue en tu Apple Watch o tu Mac: pausa en uno y los demás te siguen. Los widgets y la Dynamic Island te permiten consultar y controlar sin abrir la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez sur l’iPhone et continuez sur l’Apple Watch ou le Mac : mettez en pause sur l’un, les autres suivent. Les widgets et la Dynamic Island permettent de vérifier et de contrôler sans ouvrir l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia su iPhone e continua su Apple Watch o Mac: metti in pausa su uno e gli altri seguono. Con i widget e Dynamic Island controlli tutto senza aprire l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで始めてApple WatchやMacでそのまま続けられます。片方で止めればもう片方も止まります。ウィジェットやダイナミックアイランドからは、アプリを開かずに確認・操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 시작해 Apple Watch나 Mac에서 그대로 이어가세요. 한쪽에서 멈추면 다른 쪽도 따라 멈춥니다. 위젯과 다이나믹 아일랜드로는 앱을 열지 않고도 보고 조작할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece no iPhone e continue no Apple Watch ou no Mac — pause em um, e os outros acompanham. Com os widgets e a Dynamic Island, você vê e controla sem abrir o app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上开始，在 Apple Watch 或 Mac 上接着用 — 一边暂停，另一边也跟着停。用小组件和灵动岛，不打开 App 也能查看和操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上開始，在 Apple Watch 或 Mac 上接著用 — 一邊暫停，另一邊也跟著停。用小工具和動態島，不開啟 App 也能查看和操作。"
          }
        }
      }
    },
    "onboarding_scenario_7" : {
      "comment" : "Onboarding page 7 example",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Mac präsentieren, während dich dein Handgelenk 5 Minuten vorher antippt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenting from your Mac while your wrist taps the 5-minute warning"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenta desde tu Mac mientras tu muñeca te avisa a 5 minutos del final"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Présenter depuis votre Mac pendant que votre poignet vous signale les 5 dernières minutes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenti dal Mac mentre il polso ti avvisa a 5 minuti dalla fine"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macで発表しながら、5分前の通知は手首で受け取る"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맥으로 발표하면서 5분 전 알림은 손목으로 받기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apresentar pelo Mac enquanto o pulso avisa dos 5 minutos finais"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Mac 演讲，5 分钟前的提醒由手腕接收"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Mac 簡報，5 分鐘前的提醒由手腕接收"
          }
        }
      }
    },
    "onboarding_title_7" : {
      "comment" : "Onboarding page 7 title (multi-device)",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Timer,\nalle deine Geräte"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One timer,\nall your devices"
          }
        },
        "es" : {
          "stringUnit" : {
