        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已把 %1$@、%2$lld 个提醒的设置放回表盘。Pro 可以把这样的设置连同分段名称和讲稿一起保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已把 %1$@、%2$lld 個提醒的設定放回錶盤。Pro 可以把這樣的設定連同分段名稱和講稿一起儲存。"
          }
        }
      }
    },
    "Had Pro before but it is gone?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hattest Pro, aber es ist weg?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tenías Pro y ya no está?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous aviez Pro et il a disparu ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avevi Pro ma è sparito?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proが使えていたのに消えましたか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro를 쓰고 있었는데 사라졌나요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinha o Pro e ele sumiu?"
          }
