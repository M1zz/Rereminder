    "guide_siri_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag „Starte einen Rereminder-Timer“ – oder pausiere, setze fort und stoppe – ganz ohne Hände."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say “Start a Rereminder timer” — or pause, resume, and stop — hands-free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “Inicia un temporizador de Rereminder”, o pausa, reanuda y detén, sin usar las manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites « Lance un minuteur Rereminder », ou mettez en pause, reprenez et arrêtez, sans les mains."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' “Avvia un timer Rereminder”, oppure metti in pausa, riprendi e ferma, senza usare le mani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Rereminderタイマーを開始」と話しかけるだけ。一時停止・再開・停止もハンズフリーで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“두번알림 타이머 시작”이라고 말해보세요. 일시정지·재개·정지도 손을 쓰지 않고 가능해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga “Iniciar um timer do Rereminder” — ou pausar, retomar e parar — sem usar as mãos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说一句“开始 Rereminder 计时”就行 — 暂停、继续、停止也都不用动手。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說一句「開始 Rereminder 計時」就行 — 暫停、繼續、停止也都不用動手。"
          }
        }
      }
    },
