        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre réglage %1$@ avec %2$lld alertes est de retour sur le cadran. Pro enregistre ce genre de réglage avec les noms de vos parties et vos notes."
          }
