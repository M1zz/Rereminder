        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已儲存的紀錄並未刪除。不過現在輸入的內容不會儲存，請關閉 App 後重新開啟。"
          }
        }
      }
    },
