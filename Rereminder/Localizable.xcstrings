    "guide_widget_f3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Živý odpočet na zamčené obrazovce a v Dynamic Island má vestavěná tlačítka Pozastavit, Pokračovat a Zastavit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-nedtællingen på låseskærmen og i Dynamic Island har indbyggede knapper til Pause, Genoptag og Stop."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Live-Countdown auf dem Sperrbildschirm und in der Dynamic Island hat Tasten für Pause, Fortsetzen und Stopp."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ζωντανή αντίστροφη μέτρηση στην Οθόνη κλειδώματος και στο Dynamic Island έχει ενσωματωμένα κουμπιά Παύση, Συνέχιση και Διακοπή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The live countdown on your Lock Screen and Dynamic Island has Pause, Resume, and Stop buttons built in."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The live countdown on your Lock Screen and Dynamic Island has Pause, Resume, and Stop buttons built in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo en vivo de la pantalla bloqueada y la Dynamic Island incluye botones para pausar, reanudar y detener."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitun näytön ja Dynamic Islandin reaaliaikaisessa lähtölaskennassa on valmiina Keskeytä-, Jatka- ja Pysäytä-painikkeet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte à rebours en direct sur l’écran verrouillé et la Dynamic Island intègre les boutons Pause, Reprendre et Arrêter."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitung mundur langsung di Layar Terkunci dan Dynamic Island punya tombol Jeda, Lanjutkan, dan Hentikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il conto alla rovescia in tempo reale sulla schermata di blocco e in Dynamic Island ha i pulsanti Pausa, Riprendi e Stop integrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面と Dynamic Island のリアルタイムカウントダウンに一時停止・再開・停止ボタンがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면과 다이나믹 아일랜드의 실시간 카운트다운에 일시정지·재개·정지 버튼이 들어 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedtellingen på låst skjerm og i Dynamic Island har innebygde knapper for Pause, Fortsett og Stopp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het live aftellen op je toegangsscherm en in het Dynamic Island heeft knoppen om te pauzeren, te hervatten en te stoppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odliczanie na żywo na ekranie blokady i w Dynamic Island ma wbudowane przyciski Pauza, Wznów i Zatrzymaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A contagem ao vivo na Tela Bloqueada e na Dynamic Island já vem com os botões Pausar, Retomar e Parar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A contagem em direto no ecrã bloqueado e na Dynamic Island já inclui os botões Pausar, Retomar e Parar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В живом отсчёте на экране блокировки и в Dynamic Island есть кнопки «Пауза», «Продолжить» и «Стоп»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nedräkningen på låsskärmen och i Dynamic Island har inbyggda knappar för Pausa, Återuppta och Stopp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลานับถอยหลังแบบสดบนหน้าจอล็อคและ Dynamic Island มีปุ่มหยุดพัก ทำต่อ และหยุดในตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitli Ekran'daki ve Dynamic Island'daki canlı geri sayımda Duraklat, Sürdür ve Durdur düğmeleri hazır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đếm ngược trực tiếp trên Màn hình khóa và Dynamic Island có sẵn nút Tạm dừng, Tiếp tục và Dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定屏幕和灵动岛上的实时倒计时内置了暂停、继续和停止按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定畫面和動態島上的即時倒數計時內建了暫停、繼續和停止按鈕。"
          }
        }
      }
    },
