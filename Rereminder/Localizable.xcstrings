    "Listed in the order they will ring. Alerts longer than the timer itself never ring, so they aren't shown here." : {
      "comment" : "Notification message settings: why some alerts are missing",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seřazeno podle toho, jak budou zvonit. Upozornění delší než samotný časovač nikdy nezazvoní, proto tu nejsou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vist i den rækkefølge, de ringer. Påmindelser, der er længere end selve timeren, ringer aldrig og vises derfor ikke her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Reihenfolge, in der sie klingeln. Erinnerungen, die länger als der Timer sind, klingeln nie und erscheinen hier nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με τη σειρά που θα ηχήσουν. Όσες ειδοποιήσεις ξεπερνούν τη διάρκεια του χρονομετρητή δεν ηχούν ποτέ, γι' αυτό δεν εμφανίζονται εδώ."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listed in the order they will ring. Alerts longer than the timer itself never ring, so they aren't shown here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparecen en el orden en que sonarán. Los avisos más largos que el propio temporizador nunca suenan, así que no se muestran aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lueteltu soittojärjestyksessä. Ajastinta pidemmät muistutukset eivät koskaan soi, joten niitä ei näytetä tässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classées dans l’ordre où elles sonneront. Les alertes plus longues que le minuteur ne sonnent jamais, elles ne sont donc pas affichées ici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diurutkan sesuai urutan berbunyi. Peringatan yang lebih panjang dari timer itu sendiri tidak akan berbunyi, jadi tidak ditampilkan di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elencati nell'ordine in cui suoneranno. Gli avvisi più lunghi del timer stesso non suonano mai, quindi non compaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鳴る順に並んでいます。タイマーより長い通知は鳴らないため、ここには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "울리는 순서대로 나열돼 있어요. 타이머 길이보다 긴 알림은 울리지 않아서 여기 나오지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vises i den rekkefølgen de ringer. Varsler som er lengre enn selve tidtakeren, ringer aldri og vises derfor ikke her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op volgorde waarin ze afgaan. Meldingen die langer zijn dan de timer zelf gaan nooit af en staan hier daarom niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W kolejności, w jakiej zadzwonią. Alerty dłuższe niż sam minutnik nigdy nie zadzwonią, więc ich tu nie ma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listados na ordem em que vão tocar. Alertas maiores que o próprio timer nunca tocam, por isso não aparecem aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listados pela ordem em que vão tocar. Os alertas mais longos do que o próprio temporizador nunca tocam, por isso não aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сигналы перечислены в том порядке, в котором прозвучат. Сигналы, выставленные раньше, чем длится сам таймер, не звучат, поэтому их здесь нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listade i den ordning de ringer. Påminnelser som ligger längre bort än själva timerns längd ringer aldrig och visas därför inte här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียงตามลำดับที่จะดัง การแจ้งเตือนที่ตั้งไว้ยาวกว่าตัวจับเวลาจะไม่มีวันดัง จึงไม่แสดงที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalacakları sırayla listelenir. Zamanlayıcıdan uzun olan uyarılar hiç çalmadığı için burada görünmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sắp xếp theo thứ tự đổ chuông. Chuông báo dài hơn chính hẹn giờ sẽ không bao giờ đổ, nên không hiện ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按响铃顺序排列。比计时本身还长的提醒不会响，所以不会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依響鈴順序排列。比計時本身還長的提醒不會響，所以不會出現在這裡。"
          }
        }
      }
    },
