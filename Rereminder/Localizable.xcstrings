    "tip_presentation_message" : {
      "comment" : "TipKit: presentation mode detail",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V režimu sezení rozdělte čas na úseky – při každé změně dostanete upozornění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del tiden op i afsnit i Sessionstilstand – du får besked ved hvert skift."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teil die Zeit im Session-Modus in Abschnitte – bei jedem Wechsel wirst du erinnert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη Λειτουργία συνεδρίας χωρίστε τον χρόνο σε μέρη — θα ειδοποιείστε σε κάθε αλλαγή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Session mode, split the time into parts — you'll be told at every change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Modo sesión, divide el tiempo en partes y te avisará en cada cambio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaa aika sessiotilassa osioihin – saat muistutuksen jokaisessa vaihdossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mode Séance, découpez le temps en parties : vous serez prévenu à chaque changement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di Mode Sesi, bagi waktu menjadi beberapa bagian. Anda akan diberi tahu setiap kali bagian berganti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In modalità Sessione dividi il tempo in parti: ti avviserà a ogni cambio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションモードで導入・本編・まとめのように時間を分けると、区間が変わるたびに知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 모드로 도입·본론·마무리처럼 시간을 나누면, 구간이 바뀔 때마다 알려줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I øktmodus deler du tiden inn i deler – du får beskjed ved hvert skifte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verdeel de tijd in Sessiemodus in onderdelen — bij elke wissel krijg je een seintje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trybie sesji podziel czas na etapy – przy każdej zmianie dostaniesz znak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Modo Sessão, divida o tempo em partes — você é avisado a cada mudança."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Modo Sessão, divida o tempo em partes — é avisado a cada mudança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме этапов разделите время на части — вам подскажут при каждой смене."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dela upp tiden i avsnitt i sessionsläget – du får en påminnelse vid varje byte."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในโหมดเซสชัน ให้แบ่งเวลาเป็นช่วงๆ แล้วคุณจะได้รับการแจ้งทุกครั้งที่เปลี่ยนช่วง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum Modu'nda süreyi bölümlere ayır; her geçişte haber verilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở Chế độ Phiên, hãy chia thời gian thành từng phần — bạn sẽ được báo mỗi khi chuyển phần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用分段模式把时间分成几段，每次切换都会提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用分段模式把時間分成幾段，每次切換都會提醒你。"
          }
        }
      }
    },
