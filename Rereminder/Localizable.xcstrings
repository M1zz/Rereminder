    "guide_siri_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekněte si o konkrétní délku, třeba „Spusť časovač na 5 minut“, a hned se rozběhne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed om en bestemt længde, f.eks. »Start en timer på 5 minutter«, så starter den med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenne eine bestimmte Dauer, etwa „Starte einen 5-Minuten-Timer“, und er beginnt sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε συγκεκριμένη διάρκεια, π.χ. «Ξεκίνα χρονομετρητή 5 λεπτών», και ξεκινά αμέσως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask for a specific length, like “Start a 5 minute timer,” and it begins right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide una duración concreta, como “Inicia un temporizador de 5 minutos”, y empieza al instante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä tietty kesto, esimerkiksi ”Käynnistä 5 minuutin ajastin”, niin se alkaa heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez une durée précise, comme « Lance un minuteur de 5 minutes », et il démarre aussitôt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebutkan durasinya, misalnya “Mulai timer 5 menit”, dan timer langsung berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi una durata precisa, come “Avvia un timer di 5 minuti”, e parte subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「5分タイマーを開始」のように時間を指定するとすぐに始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“5분 타이머 시작”처럼 원하는 시간을 말하면 바로 시작됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om en bestemt lengde, som «Start en tidtaker på 5 minutter», så starter den med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag om een bepaalde duur, zoals ‘Start een timer van 5 minuten’, en hij begint meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaj konkretny czas, np. „Uruchom minutnik na 5 minut”, a od razu wystartuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça uma duração específica, como “Iniciar um timer de 5 minutos”, e ele começa na hora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça uma duração específica, como “Iniciar um temporizador de 5 minutos”, e começa de imediato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назовите длительность, например «Запусти таймер на 5 минут», и он сразу начнётся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om en viss längd, till exempel ”Starta en timer på 5 minuter”, så startar den direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบุความยาวที่ต้องการ เช่น “เริ่มตัวจับเวลา 5 นาที” แล้วจะเริ่มทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“5 dakikalık zamanlayıcı başlat” gibi bir süre söyle, hemen başlasın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nói thời lượng cụ thể, như “Bắt đầu hẹn giờ 5 phút”, và hẹn giờ chạy ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说出想要的时长，比如“开始 5 分钟计时”，就会立刻开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出想要的時長，例如「開始 5 分鐘計時」，就會立刻開始。"
          }
        }
      }
    },
