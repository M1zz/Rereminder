          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt holdes synkronisert via iCloud, så tidtakerne følger deg fra enhet til enhet."
          }
        },
        "nl" : {
          "stringUnit" : {
