    "tip_presentation_message" : {
      "comment" : "TipKit: presentation mode detail",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presentation mode divides your time into sections — intro, main, Q&A — and alerts you at each boundary."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "発表モードでイントロ・本編・Q&Aのように時間を分けると、区間が変わるたびに知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발표 모드로 인트로·본론·Q&A처럼 시간을 나누면, 구간이 바뀔 때마다 알려줍니다."
          }
        }
      }
