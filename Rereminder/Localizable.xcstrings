    "guide_iphone_f3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozastavte, obnovte nebo zastavte časovač přímo z Dynamic Island nebo zamčené obrazovky – bez otevírání aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt timeren på pause, genoptag eller stop den direkte fra Dynamic Island eller låseskærmen – uden at åbne appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiere, setze fort oder stoppe den Timer direkt in der Dynamic Island oder auf dem Sperrbildschirm – ohne die App zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παύση, συνέχιση ή διακοπή του χρονομετρητή απευθείας από το Dynamic Island ή την Οθόνη κλειδώματος — χωρίς να ανοίξετε την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, resume, or stop the timer right from the Dynamic Island or Lock Screen — no need to open the app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, resume, or stop the timer right from the Dynamic Island or Lock Screen — no need to open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa, reanuda o detén el temporizador desde la Dynamic Island o la pantalla bloqueada, sin abrir la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskeytä, jatka tai pysäytä ajastin suoraan Dynamic Islandissa tai lukitulla näytöllä – avaamatta appia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez en pause, reprenez ou arrêtez le minuteur depuis la Dynamic Island ou l’écran verrouillé, sans ouvrir l’app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeda, lanjutkan, atau hentikan timer langsung dari Dynamic Island atau Layar Terkunci tanpa membuka app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa, riprendi o ferma il timer direttamente da Dynamic Island o dalla schermata di blocco, senza aprire l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを開かずに Dynamic Island やロック画面から一時停止・再開・停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱을 열지 않아도 다이나믹 아일랜드나 잠금 화면에서 바로 일시정지·재개·정지할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett på pause, fortsett eller stopp tidtakeren rett fra Dynamic Island eller låst skjerm – uten å åpne appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzeer, hervat of stop de timer direct vanuit het Dynamic Island of het toegangsscherm — zonder de app te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymuj, wznawiaj i zatrzymuj minutnik prosto z Dynamic Island lub ekranu blokady – bez otwierania aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, retome ou pare o timer direto na Dynamic Island ou na Tela Bloqueada — sem abrir o app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause, retome ou pare o temporizador diretamente na Dynamic Island ou no ecrã bloqueado — sem abrir a app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставьте таймер на паузу, продолжайте или останавливайте его прямо из Dynamic Island или с экрана блокировки — не открывая приложение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa, återuppta eller stoppa timern direkt i Dynamic Island eller på låsskärmen – utan att öppna appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดพัก ทำต่อ หรือหยุดตัวจับเวลาได้ทันทีจาก Dynamic Island หรือหน้าจอล็อค โดยไม่ต้องเปิดแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı açmadan zamanlayıcıyı doğrudan Dynamic Island'dan veya Kilitli Ekran'dan duraklat, sürdür ya da durdur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạm dừng, tiếp tục hoặc dừng hẹn giờ ngay từ Dynamic Island hay Màn hình khóa — không cần mở ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用打开 App，直接在灵动岛或锁定屏幕上暂停、继续或停止计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用開啟 App，直接在動態島或鎖定畫面上暫停、繼續或停止計時。"
          }
        }
      }
    },
