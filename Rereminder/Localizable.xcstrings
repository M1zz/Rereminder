        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua configurazione da %1$@ con %2$lld avvisi è di nuovo sul quadrante. Pro salva configurazioni come questa con i nomi delle sezioni e i copioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@・通知 %2$lld 個の設定をダイヤルに戻しました。Proならこうした設定を区間名と台本まで一緒に保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, 알림 %2$lld개 설정을 다이얼에 다시 올려 두었어요. Pro는 이런 설정을 구간 이름과 대본까지 함께 저장합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua configuração de %1$@ com %2$lld alertas voltou ao mostrador. O Pro salva configurações assim com os nomes e roteiros das etapas."
          }
