            "value" : "Сигнал повторяется, пока вы не нажмёте «Стоп» или «Отложить» в уведомлении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminner tills du trycker på Stopp eller Snooza i notisen."
