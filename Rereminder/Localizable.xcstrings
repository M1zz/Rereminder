    "guide_watch_f3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spür bei jeder Vorwarnung und am Ende ein sanftes Tippen am Handgelenk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feel a gentle tap on your wrist at each pre-alert time and when the timer ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siente un toque suave en la muñeca en cada aviso previo y cuando termina el temporizador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentez un léger toucher au poignet à chaque pré-alerte et à la fin du minuteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senti un leggero tocco al polso a ogni preavviso e alla fine del timer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各事前アラートの時刻とタイマー終了時に手首の触覚で知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 미리 알림 시점과 타이머 종료 때 손목에 진동으로 알려줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinta um toque suave no pulso a cada pré-alerta e quando o timer termina."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个提前提醒时刻和计时结束时，手腕上都会轻轻震动提示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個提前提醒時刻和計時結束時，手腕上都會輕輕震動提示。"
