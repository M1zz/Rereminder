          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si oui, Rereminder peut afficher le temps restant dans la barre des menus de votre Mac."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika punya, Rereminder bisa menampilkan sisa waktu di bar menu Mac Anda."
