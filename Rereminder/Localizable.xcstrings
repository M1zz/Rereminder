    "guide_widget_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kruhové, obdélníkové a řádkové widgety vám ukážou odpočet jediným pohledem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde, rektangulære og indlejrede widgets viser nedtællingen med et enkelt blik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde, rechteckige und einzeilige Widgets zeigen den Countdown auf einen Blick."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κυκλικά, ορθογώνια και ενσωματωμένα γραφικά στοιχεία κρατούν την αντίστροφη μέτρηση ορατή με μια ματιά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circular, rectangular, and inline widgets keep the countdown visible at a glance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los widgets circulares, rectangulares y en línea muestran el tiempo restante de un vistazo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyöreät, suorakulmaiset ja rivinsisäiset widgetit pitävät lähtölaskennan näkyvillä yhdellä silmäyksellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les widgets circulaire, rectangulaire et en ligne gardent le compte à rebours visible d’un coup d’œil."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget bulat, persegi, dan sebaris membuat hitung mundur terlihat sekilas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I widget circolari, rettangolari e in linea tengono il conto alla rovescia sempre a portata d'occhio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "円形・長方形・インラインのウィジェットで残り時間をロック画面でひと目で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원형·사각형·인라인 위젯으로 남은 시간을 잠금 화면에서 한눈에 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde, rektangulære og innebygde widgeter holder nedtellingen synlig med et blikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ronde, rechthoekige en inline widgets houden het aftellen in één oogopslag zichtbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okrągłe, prostokątne i jednowierszowe widżety pokazują odliczanie w mgnieniu oka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets circulares, retangulares e em linha deixam a contagem regressiva sempre à vista."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets circulares, retangulares e em linha mantêm a contagem decrescente sempre à vista."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Круглый, прямоугольный и строчный виджеты держат отсчёт на виду."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runda, rektangulära och radbaserade widgetar visar nedräkningen med en snabb blick."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิดเจ็ตแบบวงกลม สี่เหลี่ยม และแบบแถว ช่วยให้เห็นเวลานับถอยหลังได้ในพริบตา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dairesel, dikdörtgen ve satır içi widget'lar geri sayımı bir bakışta görünür tutar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiện ích dạng tròn, chữ nhật và nội dòng giúp bạn thấy đếm ngược chỉ trong nháy mắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圆形、矩形和嵌入式小组件让剩余时间一眼可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圓形、長方形和文字列小工具讓剩餘時間一眼可見。"
          }
        }
      }
    },
