          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会在前一天晚上提醒你，并把现在的设置准备好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們會在前一天晚上提醒你，並把現在的設定準備好。"
