    "guide_iphone_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the time on the dial, then tap the alert chips to be reminded 1, 3, 5, or 10 minutes before the end — as many as you like."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイヤルで時間を設定し、アラートチップをタップして終了1・3・5・10分前など好きなだけ事前に通知を受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다이얼에서 시간을 맞춘 뒤 알림 칩을 눌러 종료 1·3·5·10분 전 등 원하는 만큼 미리 알림을 받으세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在表盘上设定时间，然后点按提醒标签，就能在结束前 1、3、5、10 分钟收到提醒 — 想加几个都可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在錶盤上設定時間，然後點一下提醒標籤，就能在結束前 1、3、5、10 分鐘收到提醒 — 想加幾個都可以。"
          }
        }
      }
    },
