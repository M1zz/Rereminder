    "guide_footer_note" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vše zůstává synchronizované přes iCloud, takže vaše časovače vás provázejí ze zařízení na zařízení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt holdes synkroniseret via iCloud, så dine timere følger dig fra enhed til enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt über iCloud synchron – deine Timer begleiten dich von Gerät zu Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλα συγχρονίζονται μέσω iCloud, ώστε οι χρονομετρητές σας να σας ακολουθούν από συσκευή σε συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays in sync through iCloud, so your timers follow you from device to device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se mantiene sincronizado con iCloud, así que tus temporizadores te siguen de un dispositivo a otro."
