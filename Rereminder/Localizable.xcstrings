        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイレントモードと集中モードを越えてアラーム音量で鳴ります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무음 모드와 집중 모드를 뚫고 알람 볼륨으로 울립니다"
