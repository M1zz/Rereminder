        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No encontramos ningún registro en este dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat trouvé sur cet appareil"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non abbiamo trovato alcun dato su questo dispositivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末では記録が見つかりませんでした"
