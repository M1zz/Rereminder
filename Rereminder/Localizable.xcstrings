    "guide_watch_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte délku korunkou Digital Crown a spusťte časovač i bez iPhonu poblíž."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil varigheden med Digital Crown, og start en timer uden din iPhone i nærheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell die Dauer mit der Digital Crown ein und starte einen Timer auch ohne iPhone in der Nähe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ορίστε τη διάρκεια με το Digital Crown και ξεκινήστε χρονομετρητή χωρίς το iPhone κοντά σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the duration with the Digital Crown and start a timer without your iPhone nearby."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta la duración con la Digital Crown e inicia un temporizador sin tener el iPhone cerca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta kesto Digital Crownilla ja käynnistä ajastin, vaikka iPhone ei olisi lähellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez la durée avec la Digital Crown et lancez un minuteur sans votre iPhone à proximité."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur durasi dengan Digital Crown dan mulai timer tanpa iPhone di dekat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la durata con la Digital Crown e avvia un timer anche senza iPhone vicino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneがなくても Digital Crown で時間を設定してタイマーを開始できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone이 없어도 Digital Crown으로 시간을 정하고 타이머를 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still inn varigheten med Digital Crown, og start en tidtaker uten at iPhonen er i nærheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel de duur in met de Digital Crown en start een timer, ook zonder je iPhone in de buurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw czas koronką Digital Crown i uruchom minutnik nawet bez iPhone’a w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a duração com a Digital Crown e inicie um timer sem o iPhone por perto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a duração com a Digital Crown e inicie um temporizador sem o iPhone por perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выставьте длительность колёсиком Digital Crown и запустите таймер, даже если iPhone далеко."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in längden med Digital Crown och starta en timer utan att ha din iPhone i närheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งระยะเวลาด้วย Digital Crown และเริ่มตัวจับเวลาได้แม้ไม่มี iPhone อยู่ใกล้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süreyi Digital Crown ile ayarla, iPhone'un yakında olmasa bile zamanlayıcıyı başlat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt thời lượng bằng Digital Crown và bắt đầu hẹn giờ mà không cần iPhone ở gần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用数码表冠设定时长，身边没有 iPhone 也能开始计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用數位錶冠設定時長，身邊沒有 iPhone 也能開始計時。"
          }
        }
      }
    },
