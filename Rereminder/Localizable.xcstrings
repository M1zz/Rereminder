    "Sped up %lld×. Watch the bells ring before the end." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrychleno %lld×. Sledujte, jak zvonečky zazvoní před koncem."
          }
