    "Lock the app with Face ID or Touch ID to keep your scripts and history private." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkněte aplikaci pomocí Face ID nebo Touch ID a chraňte své scénáře i historii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID, så dine manuskripter og din historik forbliver private."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID oder Touch ID, damit deine Skripte und dein Verlauf privat bleiben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κλειδώστε την εφαρμογή με Face ID ή Touch ID για να προστατεύσετε τα κείμενα και το ιστορικό σας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock the app with Face ID or Touch ID to keep your scripts and history private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la app con Face ID o Touch ID para proteger tus guiones e historial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukitse appi Face ID:llä tai Touch ID:llä ja suojaa käsikirjoituksesi ja historiasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillez l'app avec Face ID ou Touch ID pour protéger vos notes et votre historique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci app dengan Face ID atau Touch ID untuk melindungi naskah dan riwayat Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca l'app con Face ID o Touch ID per proteggere copioni e cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face IDやTouch IDでアプリをロックして、台本と履歴を守ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID나 Touch ID로 앱을 잠가 대본과 기록을 지켜요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID, så manusene og historikken din forblir private."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendel de app met Face ID of Touch ID om je scripts en geschiedenis te beschermen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokuj aplikację Face ID lub Touch ID, aby chronić notatki i historię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie o app com Face ID ou Touch ID para proteger seus roteiros e histórico."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueie a app com Face ID ou Touch ID para proteger os seus guiões e histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокируйте приложение с Face ID или Touch ID, чтобы защитить заметки и историю."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID så att dina manus och din historik förblir privata."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล็อกแอปด้วย Face ID หรือ Touch ID เพื่อปกป้องบทพูดและประวัติของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metinlerinizi ve geçmişinizi korumak için uygulamayı Face ID veya Touch ID ile kilitleyin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khóa ứng dụng bằng Face ID hoặc Touch ID để bảo vệ kịch bản và lịch sử của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用面容 ID 或触控 ID 锁定 App，保护你的讲稿和记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Face ID 或 Touch ID 鎖定 App，保護你的講稿和記錄。"
          }
        }
      }
    },
