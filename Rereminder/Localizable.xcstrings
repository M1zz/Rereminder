    "guide_watch_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte, pausiere oder stoppe auf einem Gerät, und das andere zieht mit – auch im Hintergrund."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, pause, or stop on one device and it updates on the other — even in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia, pausa o detén en un dispositivo y se actualiza en el otro, incluso en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez, mettez en pause ou arrêtez sur un appareil, et l’autre suit, même en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia, metti in pausa o ferma su un dispositivo e l'altro si aggiorna, anche in background."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片方のデバイスで開始・一時停止・停止すると、バックグラウンドでももう片方に反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한쪽 기기에서 시작·일시정지·정지하면 백그라운드에서도 다른 기기에 그대로 반영돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie, pause ou pare em um dispositivo e o outro é atualizado — mesmo em segundo plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一台设备上开始、暂停或停止，另一台也会跟着更新 — 即使在后台也一样。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一台裝置上開始、暫停或停止，另一台也會跟著更新 — 即使在背景也一樣。"
          }
        }
      }
    },
