    "Save your timers and history to a file and bring them back anytime." : {
      "comment" : "Roadmap item detail: backup and export",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte své časovače a historii do souboru a kdykoli je obnovte."
          }
        },
        "da" : {
