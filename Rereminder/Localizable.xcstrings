    "onboarding_desc_1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeping precise time during lectures, mentoring, and meetings is a mark of professionalism"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "講演、メンタリング、会議の時間を正確に守ることはプロフェッショナルの基本です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강연, 멘토링, 회의 시간을 정확하게 지키는 것은 전문성의 기본입니다"
          }
        }
      }
    },
    "onboarding_desc_2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid awkward moments from going overtime and keep your audience comfortable"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間超過による気まずい状況や聴衆の不快感を防ぎましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간 초과로 인한 당황스러운 상황, 청중의 불편함을 방지하세요"
          }
        }
      }
    },
    "onboarding_desc_3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set as many pre-alerts as you want: 10 min, 5 min, 1 min before the end"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了10分前、5分前、1分前など、好きなだけ事前アラートを設定できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료 10분 전, 5분 전, 1분 전 등 원하는 만큼 예비 알림을 설정하세요"
          }
        }
      }
    },
    "onboarding_desc_4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After 00:00, it shows +01:23 so you know exactly how much overtime"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "00:00以降も+01:23のように表示され、正確な超過時間を確認できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "00:00 이후에도 +01:23처럼 표시되어 정확히 얼마나 초과했는지 확인하세요"
          }
        }
      }
    },
    "onboarding_desc_5" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split your presentation into sections like Intro, Main, and Q&A — each with its own timer and alert"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イントロ、本論、Q&Aなどセクションごとに時間を分け、各区間でアラートを受け取れます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인트로, 본론, Q&A 등 섹션별로 시간을 나누고 각 구간마다 알림을 받으세요"
          }
        }
      }
    },
    "onboarding_desc_6" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Intuitive circular drag\n• Precise number input\n• Quick presets for instant start"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 円形ドラッグで直感的に設定\n• 数字入力で正確な時間\n• クイックプリセットですぐ開始"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 원형 드래그로 직관적 설정\n• 숫자 입력으로 정확한 시간\n• 빠른 프리셋으로 즉시 시작"
          }
        }
      }
    },
    "onboarding_desc_7" : {
      "comment" : "Onboarding page 7 description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start on iPhone and keep going on Apple Watch or Mac — pause on one, and the others follow. Widgets and the Dynamic Island let you check and control without opening the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで始めてApple WatchやMacでそのまま続けられます。片方で止めればもう片方も止まります。ウィジェットやダイナミックアイランドからは、アプリを開かずに確認・操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 시작해 Apple Watch나 Mac에서 그대로 이어가세요. 한쪽에서 멈추면 다른 쪽도 따라 멈춥니다. 위젯과 다이나믹 아일랜드로는 앱을 열지 않고도 보고 조작할 수 있어요."
          }
        }
      }
    },
