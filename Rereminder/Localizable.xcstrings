    "Rings at alarm volume, through Silent Mode and Focus" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvoní hlasitostí budíku – i v tichém režimu a při soustředění"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringer med alarmlydstyrke, også i lydløs tilstand og Fokus"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klingelt in Weckerlautstärke, trotz Stumm-Modus und Fokus"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χτυπά στην ένταση ξυπνητηριού, παρά την Αθόρυβη λειτουργία και την Εστίαση"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rings at alarm volume, through Silent Mode and Focus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suena a volumen de alarma, incluso en modo silencio y con Concentración"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soi hälytyksen äänenvoimakkuudella Äänettömän tilan ja Keskittymisen läpi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonne au volume d’alarme, même en mode silencieux et en Concentration"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berbunyi dengan volume alarm, menembus Mode Senyap dan Fokus"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
