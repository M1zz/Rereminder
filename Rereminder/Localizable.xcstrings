          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahu kapan harus menutup tanpa melihat jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai quando chiudere senza guardare l'orologio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時計を見なくても、まとめに入る頃合いが分かります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계를 보지 않고도 마무리할 때를 알 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vit når du skal runde av, uten å se på klokka."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
