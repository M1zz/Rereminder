        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ในการตั้งค่าของ Apple Watch ตรวจสอบว่าเปิดการแจ้งเตือนแบบสัมผัสไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
