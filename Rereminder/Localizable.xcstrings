    "Know when to wrap up without looking at a clock." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Víte, kdy začít končit, aniž byste se dívali na hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid, hvornår du skal runde af, uden at kigge på uret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisse, wann du zum Schluss kommen musst – ohne auf die Uhr zu schauen."
