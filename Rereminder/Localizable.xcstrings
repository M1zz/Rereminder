            "value" : "Alles blijft via iCloud gesynchroniseerd, zodat je timers je van apparaat naar apparaat volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko synchronizuje się przez iCloud, więc minutniki idą za Tobą z urządzenia na urządzenie."
