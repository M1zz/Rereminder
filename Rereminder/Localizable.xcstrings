        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο προγραμματιστής διαβάζει κάθε μήνυμα. Πείτε μας τι χρειάζεστε ή τι δεν σας άρεσε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desarrollador lee todos los mensajes. Cuéntanos qué necesitas o qué no te convenció."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehittäjä lukee jokaisen viestin. Kerro, mitä tarvitset tai mikä tuntui oudolta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le développeur lit chaque message. Dites-nous ce qui vous manque ou ce qui vous a gêné."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Developer membaca setiap pesan. Ceritakan apa yang Anda butuhkan atau yang terasa kurang pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sviluppatore legge ogni messaggio. Dicci cosa ti serve o cosa non ti ha convinto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いただいたメッセージは開発者がすべて読んでいます。必要なことや気になった点をお聞かせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보내주신 말은 개발자가 하나도 빠짐없이 읽습니다. 필요한 것이나 불편했던 점을 알려 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvikleren leser hver eneste melding. Fortell oss hva du trenger eller hva som føltes feil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ontwikkelaar leest elk bericht. Vertel ons wat je mist of wat niet lekker voelde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deweloper czyta każdą wiadomość. Napisz, czego potrzebujesz albo co Ci nie pasowało."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desenvolvedor lê todas as mensagens. Conte o que você precisa ou o que não ficou bom."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O programador lê todas as mensagens. Diga-nos do que precisa ou o que não correu bem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разработчик читает каждое сообщение. Расскажите, чего вам не хватает или что показалось странным."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utvecklaren läser varje meddelande. Berätta vad du behöver eller vad som kändes fel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นักพัฒนาอ่านทุกข้อความ บอกเราว่าคุณต้องการอะไรหรืออะไรที่ไม่ถูกใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geliştirici her mesajı okur. Neye ihtiyacın olduğunu ya da neyin tuhaf geldiğini anlat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhà phát triển đọc mọi tin nhắn. Hãy cho chúng tôi biết bạn cần gì hoặc điều gì chưa ổn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一条留言开发者都会读。告诉我们你需要什么、哪里不顺手。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
