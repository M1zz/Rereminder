    "Timers stay readable with Increase Contrast on or when colors are hard to tell apart." : {
      "comment" : "Roadmap item detail: color and contrast",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovače zůstanou čitelné se zvýšeným kontrastem i při potížích s rozlišováním barev."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timere er lette at læse med øget kontrast, eller hvis du har svært ved at skelne farver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer bleiben gut lesbar – mit erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι χρονομετρητές διαβάζονται καθαρά με αυξημένη αντίθεση ή αν δυσκολεύεστε να ξεχωρίσετε χρώματα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timers stay readable with Increase Contrast on or when colours are hard to tell apart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temporizadores se leen bien con más contraste o si te cuesta distinguir colores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajastimet erottuvat hyvin lisätyllä kontrastilla tai jos värejä on vaikea erottaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les minuteurs restent lisibles avec le contraste renforcé ou si vous distinguez mal les couleurs."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer tetap mudah dibaca dengan kontras tinggi atau saat warna sulit dibedakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I timer restano leggibili con il contrasto aumentato o se distingui a fatica i colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたときや色の区別がつきにくいときも、タイマーを見分けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 타이머를 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidtakerne er lette å lese med økt kontrast, eller hvis det er vanskelig å skille farger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timers blijven goed leesbaar met verhoogd contrast of als je kleuren moeilijk uit elkaar houdt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutniki są czytelne przy zwiększonym kontraście i gdy trudno odróżnić kolory."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os timers continuam legíveis com mais contraste ou se for difícil distinguir cores."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os temporizadores continuam legíveis com mais contraste ou se tiver dificuldade em distinguir cores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таймеры хорошо читаются при повышенном контрасте и если трудно различать цвета."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timrarna går lätt att läsa med ökad kontrast eller om du har svårt att skilja på färger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มองเห็นตัวจับเวลาได้ชัด แม้เปิดเพิ่มคอนทราสต์หรือแยกสีได้ยาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrast artırıldığında veya renkleri ayırt etmek zor olduğunda da zamanlayıcılar okunaklı kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ hẹn giờ vẫn dễ đọc khi bật tăng tương phản hoặc khi khó phân biệt màu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启“增强对比度”或难以分辨颜色时，也能看清计时器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟「增加對比」或難以分辨顏色時，也能看清計時器。"
          }
        }
      }
    },
