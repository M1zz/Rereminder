    "guide_widget_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg den Finger auf den Home-Bildschirm, tippe auf + und füge ein Rereminder-Widget hinzu. Das große zeigt sogar deine übrigen Vorwarnungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the Home Screen, tap +, and add a Rereminder widget. The large one even shows your remaining pre-alert schedule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada la pantalla de inicio, toca + y agrega un widget de Rereminder. El grande incluso muestra los avisos previos pendientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’écran d’accueil de manière prolongée, touchez +, puis ajoutez un widget Rereminder. Le grand format affiche même les pré-alertes restantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuto sulla schermata Home, tocca + e aggiungi un widget di Rereminder. Quello grande mostra anche i preavvisi rimanenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面を長押しして＋から Rereminder ウィジェットを追加します。大サイズは残りの事前アラート予定も表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면을 길게 눌러 + 버튼으로 두번알림 위젯을 추가하세요. 큰 위젯은 남은 미리 알림 일정까지 보여줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionada a Tela de Início, toque em + e adicione um widget do Rereminder. O grande mostra até os pré-alertas restantes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按主屏幕，点按 +，添加 Rereminder 小组件。大尺寸还会显示剩下的提前提醒安排。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按主畫面，點一下 +，加入 Rereminder 小工具。大尺寸還會顯示剩下的提前提醒安排。"
          }
        }
      }
    },
