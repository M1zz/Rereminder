    "Numbers roll smoothly, Voice Control knows every timer button, and alerts are clear without color." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čísla se mění plynule, Ovládání hlasem zná každé tlačítko časovače a zapnutá upozornění poznáte i bez barvy."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallene skifter blødt, Stemmestyring kender alle timerknapper, og slåede advarsler ses også uden farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlen laufen weich weiter, die Sprachsteuerung kennt jede Timer-Taste, und Vorwarnungen sind auch ohne Farbe klar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αριθμοί αλλάζουν ομαλά, ο Φωνητικός έλεγχος γνωρίζει κάθε κουμπί και οι ειδοποιήσεις ξεχωρίζουν και χωρίς χρώμα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números cambian con suavidad, Control por voz reconoce cada botón y los avisos previos se distinguen sin color."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numerot vaihtuvat pehmeästi, Puheohjaus tuntee jokaisen ajastinpainikkeen ja päällä olevat hälytykset erottuvat ilman väriäkin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chiffres défilent en douceur, le Contrôle vocal connaît chaque bouton du minuteur et les pré-alertes se distinguent sans couleur."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angka berganti dengan halus, Kontrol Suara mengenali setiap tombol timer, dan peringatan aktif terlihat tanpa warna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
