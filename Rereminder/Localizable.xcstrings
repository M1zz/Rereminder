    "On iPhone, open the Watch app → My Watch, and install Rereminder if it isn't there." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhonu otevřete aplikaci Watch → Moje hodinky a nainstalujte Rereminder, pokud tam není."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Watch-appen på iPhone → Mit ur, og installer Rereminder, hvis den ikke er der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf dem iPhone die Watch-App → Meine Uhr und installiere Rereminder, falls es fehlt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο iPhone, ανοίξτε την εφαρμογή Watch → Το ρολόι μου και εγκαταστήστε το Rereminder αν δεν υπάρχει."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el iPhone, abre la app Watch → Mi reloj e instala Rereminder si no aparece."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa iPhonessa Watch-appi → Oma kello ja asenna Rereminder, jos sitä ei ole."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’iPhone, ouvrez l’app Watch → Ma montre, et installez Rereminder s’il n’y est pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di iPhone, buka app Watch → Jam Saya, lalu instal Rereminder jika belum ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su iPhone, apri l'app Watch → Il mio orologio e installa Rereminder se non c'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneのWatchアプリ →「マイウォッチ」でRereminderがなければインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone의 Watch 앱 → 내 시계에서 두번알림이 없으면 설치하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne Watch-appen på iPhone → Min klokke, og installer Rereminder hvis den ikke er der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open op je iPhone de Watch-app → Mijn horloge en installeer Rereminder als het er nog niet op staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhonie otwórz aplikację Watch → Mój zegarek i zainstaluj Rereminder, jeśli go tam nie ma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPhone, abra o app Watch → Meu Relógio e instale o Rereminder se ele não estiver lá."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No iPhone, abra a app Watch → O meu relógio e instale o Rereminder, caso não esteja lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPhone откройте приложение Watch → «Мои часы» и установите Rereminder, если его там нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Apple Watch-appen på iPhone → Min klocka och installera Rereminder om den inte finns där."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บน iPhone ให้เปิดแอป Watch → นาฬิกาของฉัน แล้วติดตั้ง Rereminder หากยังไม่มี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'da Watch uygulamasını aç → Saatim; Rereminder orada yoksa yükle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên iPhone, mở ứng dụng Watch → Đồng hồ của tôi và cài Rereminder nếu chưa có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上打开“Watch”App →“我的手表”，如果没有 Rereminder 就安装它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上開啟「Watch」App →「我的手錶」，如果沒有 Rereminder 就安裝它。"
          }
        }
      }
    },
    "onboarding_desc_7" : {
      "comment" : "Onboarding page 7 description",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Začněte na iPhonu a pokračujte na Apple Watch nebo Macu – pozastavíte na jednom, ostatní se přidají. Díky widgetům a Dynamic Island můžete vše sledovat a ovládat bez otevírání aplikace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start på iPhone, og fortsæt på Apple Watch eller Mac – sætter du på pause på én, følger de andre med. Med widgets og Dynamic Island kan du se og styre det hele uden at åbne appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte auf dem iPhone und mach auf Apple Watch oder Mac weiter – pausierst du auf einem Gerät, folgen die anderen. Mit Widgets und der Dynamic Island siehst und steuerst du alles, ohne die App zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε στο iPhone και συνεχίστε στο Apple Watch ή στον Mac — κάντε παύση στη μία συσκευή και οι άλλες ακολουθούν. Με τα γραφικά στοιχεία και το Dynamic Island βλέπετε και ελέγχετε χωρίς να ανοίξετε την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start on iPhone and keep going on Apple Watch or Mac — pause on one, and the others follow. Widgets and the Dynamic Island let you check and control without opening the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza en el iPhone y sigue en tu Apple Watch o tu Mac: pausa en uno y los demás te siguen. Los widgets y la Dynamic Island te permiten consultar y controlar sin abrir la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita iPhonessa ja jatka Apple Watchissa tai Macissa – kun keskeytät yhdellä, muut seuraavat. Widgeteillä ja Dynamic Islandilla näet ja ohjaat kaikkea avaamatta appia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez sur l’iPhone et continuez sur l’Apple Watch ou le Mac : mettez en pause sur l’un, les autres suivent. Les widgets et la Dynamic Island permettent de vérifier et de contrôler sans ouvrir l’app."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai di iPhone dan lanjutkan di Apple Watch atau Mac. Jeda di satu perangkat, yang lain ikut. Widget dan Dynamic Island memungkinkan Anda memantau dan mengendalikan timer tanpa membuka app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia su iPhone e continua su Apple Watch o Mac: metti in pausa su uno e gli altri seguono. Con i widget e Dynamic Island controlli tutto senza aprire l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneで始めてApple WatchやMacでそのまま続けられます。片方で止めればもう片方も止まります。ウィジェットやダイナミックアイランドからは、アプリを開かずに確認・操作できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 시작해 Apple Watch나 Mac에서 그대로 이어가세요. 한쪽에서 멈추면 다른 쪽도 따라 멈춥니다. 위젯과 다이나믹 아일랜드로는 앱을 열지 않고도 보고 조작할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start på iPhone og fortsett på Apple Watch eller Mac – setter du på pause på én, følger de andre etter. Med widgeter og Dynamic Island kan du følge med og styre uten å åpne appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start op je iPhone en ga verder op Apple Watch of Mac — pauzeer je op het ene apparaat, dan volgen de andere. Met widgets en het Dynamic Island kijk en bedien je alles zonder de app te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zacznij na iPhonie i kontynuuj na Apple Watch lub Macu – wstrzymasz na jednym, a pozostałe zrobią to samo. Widżety i Dynamic Island pozwalają sprawdzać i sterować bez otwierania aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece no iPhone e continue no Apple Watch ou no Mac — pause em um, e os outros acompanham. Com os widgets e a Dynamic Island, você vê e controla sem abrir o app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece no iPhone e continue no Apple Watch ou no Mac — pause num e os outros acompanham. Com os widgets e a Dynamic Island, vê e controla sem abrir a app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните на iPhone и продолжайте на Apple Watch или Mac: поставите на паузу на одном — остальные последуют. Виджеты и Dynamic Island позволяют следить и управлять, не открывая приложение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta på iPhone och fortsätt på Apple Watch eller Mac – pausar du på en enhet följer de andra med. Med widgetar och Dynamic Island ser och styr du allt utan att öppna appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มบน iPhone แล้วไปต่อบน Apple Watch หรือ Mac ได้เลย หยุดพักที่เครื่องหนึ่ง เครื่องอื่นก็หยุดตาม ส่วนวิดเจ็ตและ Dynamic Island ช่วยให้ดูและควบคุมได้โดยไม่ต้องเปิดแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone'da başla, Apple Watch'ta ya da Mac'te devam et; birinde duraklatınca diğerleri de takip eder. Widget'lar ve Dynamic Island ile uygulamayı açmadan izleyip yönetebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu trên iPhone rồi tiếp tục trên Apple Watch hoặc Mac — tạm dừng ở một nơi, các nơi khác cũng dừng theo. Tiện ích và Dynamic Island giúp bạn xem và điều khiển mà không cần mở ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上开始，在 Apple Watch 或 Mac 上接着用 — 一边暂停，另一边也跟着停。用小组件和灵动岛，不打开 App 也能查看和操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上開始，在 Apple Watch 或 Mac 上接著用 — 一邊暫停，另一邊也跟著停。用小工具和動態島，不開啟 App 也能查看和操作。"
          }
        }
      }
    },
    "onboarding_scenario_7" : {
      "comment" : "Onboarding page 7 example",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezentujete z Macu a zápěstí vám ťukne 5 minut před koncem"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold oplæg fra din Mac, mens håndleddet giver dig et prik 5 minutter før"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am Mac präsentieren, während dich dein Handgelenk 5 Minuten vorher antippt"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Παρουσίαση από τον Mac, ενώ η προειδοποίηση των 5 λεπτών έρχεται στον καρπό σας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenting from your Mac while your wrist taps the 5-minute warning"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenta desde tu Mac mientras tu muñeca te avisa a 5 minutos del final"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esität Macilla, ja ranteesi muistuttaa 5 minuuttia ennen loppua"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Présenter depuis votre Mac pendant que votre poignet vous signale les 5 dernières minutes"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presentasi dari Mac sementara pergelangan tangan Anda menerima peringatan 5 menit"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenti dal Mac mentre il polso ti avvisa a 5 minuti dalla fine"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macで発表しながら、5分前の通知は手首で受け取る"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "맥으로 발표하면서 5분 전 알림은 손목으로 받기"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenter fra Mac-en mens håndleddet gir deg et prikk 5 minutter før"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenteren vanaf je Mac terwijl je pols je 5 minuten van tevoren een tikje geeft"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezentujesz z Maca, a nadgarstek daje znać 5 minut przed końcem"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apresentar pelo Mac enquanto o pulso avisa dos 5 minutos finais"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apresentar a partir do Mac enquanto o pulso avisa dos 5 minutos finais"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выступаете с Mac, а часы на запястье тихо напоминают: осталось 5 минут"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du presenterar från din Mac medan handleden knackar dig 5 minuter innan"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำเสนอจาก Mac ขณะที่ข้อมือสั่นเตือนก่อนจบ 5 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunumu Mac'inden yaparken 5 dakika uyarısı bileğine gelsin"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thuyết trình bằng máy Mac, còn lời nhắc 5 phút thì rung trên cổ tay"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Mac 演讲，5 分钟前的提醒由手腕接收"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 Mac 簡報，5 分鐘前的提醒由手腕接收"
          }
        }
      }
    },
    "onboarding_title_7" : {
      "comment" : "Onboarding page 7 title (multi-device)",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden časovač,\nvšechna vaše zařízení"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én timer,\nalle dine enheder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Timer,\nalle deine Geräte"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένας χρονομετρητής,\nόλες οι συσκευές σας"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One timer,\nall your devices"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un temporizador,\nen todos tus dispositivos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi ajastin,\nkaikki laitteesi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un minuteur,\ntous vos appareils"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu timer,\nsemua perangkat Anda"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un timer,\ntutti i tuoi dispositivi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとつのタイマーを\nすべてのデバイスで"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머 하나로\n모든 기기에서"
          }
        },
        "nb" : {
          "stringUnit" : {
