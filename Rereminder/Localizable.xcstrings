    "Your timers, pre-alerts, last setup, overtime and everything you've saved stay free." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časovače, upozornění, poslední nastavení, přesčas a vše uložené zůstává zdarma."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine timere, forvarsler, seneste opsætning, overtid og alt det gemte forbliver gratis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Timer, Vorwarnungen, dein letztes Setup, die Überzeit und alles Gesicherte bleiben kostenlos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι χρονομετρητές, οι προειδοποιήσεις, η τελευταία ρύθμιση, η υπέρβαση χρόνου και όσα αποθηκεύσατε μένουν δωρεάν."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your timers, pre-alerts, last setup, overtime and everything you've saved stay free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus temporizadores, avisos previos, última configuración, tiempo extra y todo lo guardado siguen gratis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajastimet, muistutukset, viimeisimmät asetukset, yliaika ja kaikki tallennettu pysyvät ilmaisina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos minuteurs, pré-alertes, dernier réglage, dépassement et tout ce que vous avez enregistré restent gratuits."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer, peringatan awal, pengaturan terakhir, lewat waktu, dan semua yang tersimpan tetap gratis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timer, preavvisi, ultima configurazione, tempo extra e tutto ciò che hai salvato restano gratuiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマー、事前アラート、前回の設定、オーバータイムの計測、保存したものはすべて無料のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머, 예비 알림, 마지막 설정, 초과 시간 기록, 저장해 둔 모든 것은 계속 무료예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timerne, forvarslene, siste oppsett, overtid og alt du har lagret forblir gratis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je timers, voorwaarschuwingen, laatste setup, overtijd en alles wat je hebt bewaard blijven gratis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minutniki, ostrzeżenia, ostatnia konfiguracja, czas po terminie i wszystko, co zapisano, pozostają bezpłatne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus timers, pré-alertas, última configuração, tempo extra e tudo o que você salvou continuam grátis."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus temporizadores, pré-alertas, última configuração, tempo extra e tudo o que guardou continuam gratuitos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таймеры, сигналы, последняя настройка, овертайм и всё сохранённое остаются бесплатными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina timers, förvarningar, senaste upplägg, övertid och allt du sparat förblir gratis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวจับเวลา การแจ้งเตือนล่วงหน้า ชุดตั้งค่าล่าสุด เวลาเกิน และทุกอย่างที่บันทึกไว้ยังคงฟรี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanlayıcılarınız, ön uyarılarınız, son ayarınız, ek süre ve kaydettiğiniz her şey ücretsiz kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hẹn giờ, báo trước, cài đặt gần nhất, quá giờ và mọi thứ đã lưu vẫn miễn phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计时器、提前提醒、上次的设置、超时计时以及你保存的一切都继续免费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計時器、提前提醒、上次的設定、超時計時以及你儲存的一切都繼續免費。"
          }
        }
      }
    },
    "When the timer rings, you've already failed to keep time" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když časovač zazvoní, čas jste už neuhlídali"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når timeren ringer, har du allerede mistet styr på tiden"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Timer klingelt, ist dein Zeitplan schon gescheitert"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν χτυπήσει ο χρονομετρητής, έχετε ήδη χάσει τον έλεγχο του χρόνου"
