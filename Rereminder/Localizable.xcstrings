            "value" : "Varsa Rereminder kalan süreyi Mac'inin menü çubuğunda gösterebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu có, Rereminder có thể hiện thời gian còn lại trên thanh menu của máy Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有的话，Rereminder 也能在 Mac 菜单栏显示剩余时间。"
