    "onboarding_title_7" : {
      "comment" : "Onboarding page 7 title (multi-device)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One timer,\nall your devices"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとつのタイマーを\nすべてのデバイスで"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머 하나로\n모든 기기에서"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
