        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve o tempo e os alertas que você acabou de definir e inicie o mesmo timer com um toque da próxima vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
