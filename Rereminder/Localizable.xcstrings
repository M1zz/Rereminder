          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedät, milloin lopetella, katsomatta kelloa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sachez quand conclure sans regarder l’heure."
          }
