        }
      }
    },
    "On iPhone, open the Watch app, go to Notifications, and check that Rereminder is allowed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhonu otevřete aplikaci Watch, přejděte do Oznámení a zkontrolujte, že je Rereminder povolený."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Watch-appen på iPhone, gå til Notifikationer, og tjek, at Rereminder er tilladt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne auf dem iPhone die Watch-App, gehe zu „Mitteilungen“ und prüfe, ob Rereminder erlaubt ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο iPhone, ανοίξτε την εφαρμογή Watch, μεταβείτε στις Γνωστοποιήσεις και ελέγξτε ότι το Rereminder επιτρέπεται."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
