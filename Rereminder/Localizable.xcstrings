    "guide_iphone_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sledujte průběh ve widgetech na ploše a na zamčené obrazovce nebo časovač spusťte a zastavte jediným klepnutím v Ovládacím centru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg med i widgets på hjemmeskærmen og låseskærmen, eller start og stop med ét tryk i Kontrolcenter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge den Fortschritt in Widgets auf Home- und Sperrbildschirm oder starte und stoppe mit einem Tippen im Kontrollzentrum."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε την πρόοδο από τα γραφικά στοιχεία της Οθόνης αφετηρίας και της Οθόνης κλειδώματος ή ξεκινήστε και σταματήστε με ένα άγγιγμα από το Κέντρο ελέγχου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check progress from Home and Lock Screen widgets, or start and stop with a single tap from Control Center."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check progress from Home and Lock Screen widgets, or start and stop with a single tap from Control Centre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta el progreso en los widgets de la pantalla de inicio y de la pantalla bloqueada, o inicia y detén con un toque desde el Centro de control."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuraa etenemistä Koti-valikon ja lukitun näytön widgeteistä tai käynnistä ja pysäytä yhdellä napautuksella Ohjauskeskuksesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez la progression depuis les widgets de l’écran d’accueil et de l’écran verrouillé, ou lancez et arrêtez d’un seul toucher depuis le centre de contrôle."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantau progres dari widget Layar Utama dan Layar Terkunci, atau mulai dan hentikan dengan sekali ketuk dari Pusat Kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l'avanzamento dai widget della schermata Home e della schermata di blocco, oppure avvia e ferma con un tocco da Centro di Controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面やロック画面のウィジェットで進行状況を確認したり、コントロールセンターからワンタップで開始・停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈·잠금 화면 위젯으로 진행 상황을 확인하거나 제어 센터에서 한 번에 시작·정지하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg med på fremdriften i widgeter på Hjem-skjermen og låst skjerm, eller start og stopp med ett trykk i Kontrollsenter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volg de voortgang met widgets op je beginscherm en toegangsscherm, of start en stop met één tik vanuit het bedieningspaneel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śledź postęp w widżetach na ekranie początkowym i ekranie blokady albo uruchamiaj i zatrzymuj jednym stuknięciem w centrum sterowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o progresso nos widgets da Tela de Início e da Tela Bloqueada, ou inicie e pare com um toque na Central de Controle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o progresso nos widgets do ecrã principal e do ecrã bloqueado, ou inicie e pare com um toque na central de controlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следите за ходом таймера в виджетах на экране «Домой» и экране блокировки или запускайте и останавливайте его одним касанием в Пункте управления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ förloppet i widgetar på hemskärmen och låsskärmen, eller starta och stoppa med ett tryck i Kontrollcenter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูความคืบหน้าจากวิดเจ็ตบนหน้าจอโฮมและหน้าจอล็อค หรือเริ่มและหยุดได้ในแตะเดียวจากศูนย์ควบคุม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlerlemeyi Ana Ekran ve Kilitli Ekran widget'larından izle ya da Denetim Merkezi'nden tek dokunuşla başlat ve durdur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo dõi tiến độ bằng tiện ích trên Màn hình chính và Màn hình khóa, hoặc bắt đầu và dừng chỉ với một chạm từ Trung tâm điều khiển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用主屏幕和锁定屏幕小组件查看进度，或在控制中心一点即可开始与停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用主畫面和鎖定畫面小工具查看進度，或在控制中心點一下即可開始與停止。"
          }
        }
      }
    },
