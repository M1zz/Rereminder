    "Each alert can carry its own message. When that moment arrives, this is the text you see in the notification and on screen." : {
      "comment" : "Notification message settings: what this screen does",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Erinnerung kann ihren eigenen Text haben. Wenn der Moment kommt, siehst du diesen Text in der Mitteilung und auf dem Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada aviso puede llevar su propio mensaje. Cuando llegue ese momento, verás este texto en la notificación y en la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque alerte peut avoir son propre message. Le moment venu, c’est ce texte qui s’affiche dans la notification et à l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni avviso può avere il suo messaggio. Quando arriva quel momento, è il testo che vedi nella notifica e sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知ごとに違う文言を設定できます。その時刻になると、ここに書いた文言が通知と画面にそのまま表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림마다 다른 문구를 넣을 수 있어요. 그 시각이 되면 여기 적은 문구가 알림과 화면에 그대로 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada alerta pode ter sua própria mensagem. Quando chegar o momento, este é o texto que aparece na notificação e na tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个提醒都可以有自己的文案。到了那一刻，通知和屏幕上显示的就是这里写的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個提醒都可以有自己的文案。到了那一刻，通知和螢幕上顯示的就是這裡寫的內容。"
          }
        }
      }
    },
    "Ease out of deep work instead of being cut off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass konzentrierte Arbeit sanft ausklingen, statt abrupt aufzuhören."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sal poco a poco del trabajo profundo en lugar de cortarlo de golpe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortez en douceur d’un travail profond au lieu d’être coupé net."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esci dal lavoro concentrato con calma, senza tagli bruschi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中を断ち切らず、ゆっくり抜け出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몰입을 뚝 끊지 않고 천천히 빠져나올 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saia do foco profundo aos poucos, sem ser interrompido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让专注慢慢收尾，而不是被突然打断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓專注慢慢收尾，而不是被突然打斷。"
          }
        }
      }
    },
