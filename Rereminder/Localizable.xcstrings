    "guide_siri_f3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Rereminder-Aktionen in der Kurzbefehle-App für eigene Abläufe und Automationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop Rereminder actions into the Shortcuts app to build your own routines and automations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega acciones de Rereminder a la app Atajos para crear tus propias rutinas y automatizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des actions Rereminder dans l’app Raccourcis pour créer vos propres routines et automatisations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi le azioni di Rereminder all'app Comandi Rapidi per creare routine e automazioni tutte tue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットアプリに Rereminder のアクションを追加して、独自のルーティンや自動化を作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축어 앱에 두번알림 동작을 넣어 나만의 루틴과 자동화를 만들 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque ações do Rereminder no app Atalhos para criar suas próprias rotinas e automações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 Rereminder 的操作加进“快捷指令”App，做出属于自己的流程和自动化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 Rereminder 的操作加進「捷徑」App，做出屬於自己的流程和自動化。"
