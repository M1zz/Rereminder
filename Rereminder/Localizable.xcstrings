    "guide_widget_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runde, rechteckige und einzeilige Widgets zeigen den Countdown auf einen Blick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circular, rectangular, and inline widgets keep the countdown visible at a glance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los widgets circulares, rectangulares y en línea muestran el tiempo restante de un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les widgets circulaire, rectangulaire et en ligne gardent le compte à rebours visible d’un coup d’œil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I widget circolari, rettangolari e in linea tengono il conto alla rovescia sempre a portata d'occhio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "円形・長方形・インラインのウィジェットで残り時間をロック画面でひと目で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원형·사각형·인라인 위젯으로 남은 시간을 잠금 화면에서 한눈에 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widgets circulares, retangulares e em linha deixam a contagem regressiva sempre à vista."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圆形、矩形和嵌入式小组件让剩余时间一眼可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圓形、長方形和文字列小工具讓剩餘時間一眼可見。"
