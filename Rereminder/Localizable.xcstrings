    "guide_widget_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte prst na ploše, klepněte na + a přidejte widget Rereminder. Velký widget ukazuje i zbývající upozornění předem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på hjemmeskærmen, tryk på +, og tilføj en Rereminder-widget. Den store viser endda dine resterende forvarsler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg den Finger auf den Home-Bildschirm, tippe auf + und füge ein Rereminder-Widget hinzu. Das große zeigt sogar deine übrigen Vorwarnungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε παρατεταμένα την Οθόνη αφετηρίας, πατήστε + και προσθέστε ένα γραφικό στοιχείο Rereminder. Το μεγάλο δείχνει ακόμη και το πρόγραμμα των προειδοποιήσεων που απομένουν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the Home Screen, tap +, and add a Rereminder widget. The large one even shows your remaining pre-alert schedule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada la pantalla de inicio, toca + y agrega un widget de Rereminder. El grande incluso muestra los avisos previos pendientes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina Koti-valikkoa pitkään, napauta + ja lisää Rereminder-widget. Suuri widget näyttää jopa jäljellä olevat ennakkomuistutukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez l’écran d’accueil de manière prolongée, touchez +, puis ajoutez un widget Rereminder. Le grand format affiche même les pré-alertes restantes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan Layar Utama, ketuk +, lalu tambahkan widget Rereminder. Widget besar bahkan menampilkan jadwal peringatan awal yang tersisa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuto sulla schermata Home, tocca + e aggiungi un widget di Rereminder. Quello grande mostra anche i preavvisi rimanenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面を長押しして＋から Rereminder ウィジェットを追加します。大サイズは残りの事前アラート予定も表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면을 길게 눌러 + 버튼으로 두번알림 위젯을 추가하세요. 큰 위젯은 남은 미리 알림 일정까지 보여줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på Hjem-skjermen, trykk på + og legg til en Rereminder-widget. Den store viser til og med de gjenværende forvarslene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je vinger op het beginscherm, tik op + en voeg een Rereminder-widget toe. De grote widget toont zelfs je resterende voorwaarschuwingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij i przytrzymaj ekran początkowy, stuknij + i dodaj widżet Rereminder. Duży widżet pokazuje nawet pozostałe ostrzeżenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionada a Tela de Início, toque em + e adicione um widget do Rereminder. O grande mostra até os pré-alertas restantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o dedo no ecrã principal, toque em + e adicione um widget do Rereminder. O grande mostra até os pré-alertas que faltam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь экрана «Домой» и удерживайте, нажмите + и добавьте виджет Rereminder. Большой виджет показывает и оставшиеся предупреждения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll fingret på hemskärmen, tryck på + och lägg till en Rereminder-widget. Den stora visar till och med dina återstående förvarningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะหน้าจอโฮมค้างไว้ แตะ + แล้วเพิ่มวิดเจ็ต Rereminder วิดเจ็ตขนาดใหญ่ยังแสดงกำหนดการแจ้งเตือนล่วงหน้าที่เหลืออยู่ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana Ekran'a dokunup basılı tut, + simgesine dokun ve bir Rereminder widget'ı ekle. Büyük widget kalan ön uyarı planını bile gösterir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm và giữ Màn hình chính, chạm +, rồi thêm tiện ích Rereminder. Tiện ích cỡ lớn còn hiện lịch báo trước còn lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按主屏幕，点按 +，添加 Rereminder 小组件。大尺寸还会显示剩下的提前提醒安排。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長按主畫面，點一下 +，加入 Rereminder 小工具。大尺寸還會顯示剩下的提前提醒安排。"
          }
        }
      }
    },
