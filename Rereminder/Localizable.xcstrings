          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli tak, Rereminder może pokazywać pozostały czas na pasku menu Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tiver, o Rereminder pode mostrar o tempo restante na barra de menus do Mac."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tiver, o Rereminder pode mostrar o tempo restante na barra de menus do Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тогда Rereminder сможет показывать оставшееся время в строке меню Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Då kan Rereminder visa återstående tid i menyraden på din Mac."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้ามี Rereminder จะแสดงเวลาที่เหลือบนแถบเมนูของ Mac ได้"
