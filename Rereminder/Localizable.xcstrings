          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ được đồng bộ qua iCloud, nên hẹn giờ đi theo bạn từ thiết bị này sang thiết bị khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
