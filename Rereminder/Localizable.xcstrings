    "From here, paid plans cover more than %lld saved setups, older history, and Session Mode after your remaining free runs." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od teď placené plány zahrnují více než %lld uložených nastavení, starší historii a Režim sezení po zbývajících bezplatných spuštěních."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herfra dækker betalte planer mere end %lld gemte opsætninger, ældre historik og Sessionstilstand efter dine resterende gratis kørsler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab jetzt gehören mehr als %lld gesicherte Setups, älterer Verlauf und der Session-Modus nach deinen restlichen Gratis-Durchläufen zu den Bezahlplänen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Από εδώ και πέρα τα συνδρομητικά πλάνα καλύπτουν πάνω από %lld αποθηκευμένες ρυθμίσεις, το παλαιότερο ιστορικό και τη Λειτουργία συνεδρίας μετά τις υπόλοιπες δωρεάν χρήσεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From here, paid plans cover more than %lld saved setups, older history, and Session Mode after your remaining free runs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de ahora, los planes de pago cubren más de %lld configuraciones guardadas, el historial antiguo y el Modo sesión tras tus usos gratis restantes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tästä eteenpäin maksullisiin tilauksiin kuuluvat yli %lld tallennettua asetusta, vanhempi historia ja Sessiotila jäljellä olevien ilmaiskertojen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désormais, les formules payantes couvrent plus de %lld réglages enregistrés, l’historique ancien et le mode Séance après vos essais gratuits restants."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai sekarang paket berbayar mencakup lebih dari %lld pengaturan tersimpan, riwayat lama, dan Mode Sesi setelah sisa penggunaan gratis Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da qui in poi i piani a pagamento coprono più di %lld configurazioni salvate, la cronologia passata e la Modalità Sessione dopo gli usi gratuiti rimasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここからは、%lld個を超える保存した設定、過去の履歴、残りの無料回数のあとのセッションモードが有料プランの対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제부터 유료 요금제에 포함되는 것은 저장한 설정 %lld개 초과, 지난 기록, 남은 무료 횟수 이후의 세션 모드예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herfra dekker betalte planer mer enn %lld lagrede oppsett, eldre historikk og Øktmodus etter de gjenværende gratis kjøringene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanaf nu vallen meer dan %lld bewaarde setups, oudere geschiedenis en Sessiemodus na je resterende gratis keren onder de betaalde plannen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od teraz plany płatne obejmują ponad %lld zapisanych konfiguracji, starszą historię i Tryb sesji po wykorzystaniu pozostałych bezpłatnych uruchomień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de agora, os planos pagos cobrem mais de %lld configurações salvas, o histórico antigo e o Modo Sessão depois dos seus usos grátis restantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de agora, os planos pagos cobrem mais de %lld configurações guardadas, o histórico antigo e o Modo Sessão depois das suas utilizações gratuitas restantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дальше платные планы включают больше %lld сохранённых настроек, старую историю и Режим этапов после оставшихся бесплатных запусков."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Härifrån ingår fler än %lld sparade upplägg, äldre historik och Sessionsläge efter dina återstående gratiskörningar i betalplanerna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จากนี้ แผนแบบชำระเงินครอบคลุมชุดตั้งค่าที่บันทึกไว้เกิน %lld ชุด ประวัติเก่า และโหมดเซสชันหลังใช้สิทธิ์ฟรีที่เหลือหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bundan sonra %lld üzeri kayıtlı ayar, eski geçmiş ve kalan ücretsiz kullanımlardan sonra Oturum Modu ücretli planlara dahildir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ đây, gói trả phí bao gồm hơn %lld cài đặt đã lưu, lịch sử cũ và Chế độ Phiên sau các lượt miễn phí còn lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从现在起，付费方案包含超过 %lld 个的保存设置、更早的记录，以及用完剩余免费次数后的分段模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從現在起，付費方案包含超過 %lld 個的儲存設定、更早的記錄，以及用完剩餘免費次數後的分段模式。"
          }
        }
      }
    },
