    "tip_template_message" : {
      "comment" : "TipKit: save template detail",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere Zeit und Erinnerungen, die du gerade eingestellt hast, und starte denselben Timer nächstes Mal mit einem Tipp."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the time and alerts you just set, and start the same timer with one tap next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el tiempo y los avisos que acabas de ajustar y, la próxima vez, inicia el mismo temporizador con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez la durée et les alertes que vous venez de régler, et relancez le même minuteur d’un toucher la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva il tempo e gli avvisi che hai appena impostato e la prossima volta avvia lo stesso timer con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま設定した時間と通知を保存しておくと、次回はワンタップで同じタイマーを開始できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 맞춘 시간과 알림을 저장해 두면, 다음엔 한 번에 같은 타이머를 시작할 수 있어요."
