    "Every feature is still here. Saved setups are behind the bookmark button, and alerts are one button below the dial." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Všechny funkce tu stále jsou. Uložená nastavení najdete pod tlačítkem záložky a upozornění pod tlačítkem pod číselníkem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle funktioner er her stadig. Gemte indstillinger ligger bag bogmærkeknappen, og påmindelser under knappen ved drejeknappen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Funktionen sind noch da. Gespeicherte Einstellungen findest du hinter dem Lesezeichen, Vorwarnungen über die Taste unter dem Drehrad."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όλες οι λειτουργίες είναι ακόμα εδώ. Οι αποθηκευμένες ρυθμίσεις βρίσκονται στο κουμπί σελιδοδείκτη και οι ειδοποιήσεις στο κουμπί κάτω από τον επιλογέα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every feature is still here. Saved setups are behind the bookmark button, and alerts are one button below the dial."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las funciones siguen aquí. Los ajustes guardados están tras el botón de marcador y los avisos en el botón bajo el dial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki toiminnot ovat yhä tallella. Tallennetut asetukset löytyvät kirjanmerkkipainikkeen takaa ja hälytykset kellotaulun alla olevasta painikkeesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les fonctions sont toujours là. Les réglages enregistrés sont derrière le bouton signet, et les pré-alertes sous le bouton du cadran."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua fitur masih ada. Pengaturan tersimpan ada di tombol penanda, dan peringatan di tombol di bawah dial."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le funzioni sono ancora qui. Le impostazioni salvate sono nel pulsante segnalibro, i preavvisi nel pulsante sotto il quadrante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機能はすべてそのままです。保存した設定はブックマークボタンの中に、通知はダイヤルの下のボタンにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기능은 모두 그대로입니다. 저장한 설정은 책갈피 버튼 안에, 알림은 다이얼 아래 버튼 하나에 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle funksjonene er her fortsatt. Lagrede oppsett ligger bak bokmerkeknappen, og varsler under knappen nedenfor skiven."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle functies zijn er nog. Opgeslagen instellingen vind je achter de bladwijzerknop, meldingen via de knop onder de draaiknop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie funkcje wciąż tu są. Zapisane ustawienia znajdziesz pod przyciskiem zakładki, a alerty pod przyciskiem poniżej tarczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os recursos continuam aqui. As configurações salvas ficam no botão de marcador, e os alertas no botão abaixo do mostrador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as funcionalidades continuam aqui. As configurações guardadas estão no botão de marcador e os alertas no botão abaixo do mostrador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все функции на месте. Сохранённые настройки находятся за кнопкой закладки, а оповещения — за кнопкой под циферблатом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla funktioner finns kvar. Sparade inställningar ligger bakom bokmärkesknappen och aviseringar under knappen nedanför ratten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟีเจอร์ทั้งหมดยังอยู่ครบ การตั้งค่าที่บันทึกไว้อยู่ในปุ่มบุ๊กมาร์ก และการแจ้งเตือนอยู่ในปุ่มใต้หน้าปัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm özellikler hâlâ burada. Kayıtlı ayarlar yer imi düğmesinde, uyarılar kadranın altındaki düğmede."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi tính năng vẫn còn đây. Thiết lập đã lưu nằm trong nút dấu trang, và cảnh báo nằm ở nút bên dưới mặt số."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有功能都还在。已保存的设置在书签按钮中，提醒在表盘下方的按钮中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有功能都還在。已儲存的設定在書籤按鈕中，提醒在錶盤下方的按鈕中。"
          }
        }
      }
    },
