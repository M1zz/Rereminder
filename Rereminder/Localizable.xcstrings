    "Silent Mode mutes alert sounds. Check the switch and the volume." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tichý režim vypíná zvuk upozornění. Zkontrolujte tichý režim a hlasitost."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lydløs tilstand slår lyden fra. Tjek lydløs tilstand og lydstyrken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
