    "Leave this off in quiet places - it ignores Silent Mode on purpose." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tichém prostředí nechte vypnuté – tichý režim záměrně ignoruje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad den være slået fra på stille steder – den ignorerer bevidst lydløs tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In ruhigen Umgebungen lieber aus – der Stumm-Modus wird absichtlich ignoriert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κρατήστε το απενεργοποιημένο σε ήσυχους χώρους - αγνοεί σκόπιμα την Αθόρυβη λειτουργία."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave this off in quiet places - it ignores Silent Mode on purpose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívala en lugares silenciosos: ignora el modo silencio a propósito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä tämä pois päältä hiljaisissa paikoissa – se ohittaa Äänettömän tilan tarkoituksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez cette option désactivée dans les lieux calmes : elle ignore volontairement le mode silencieux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan ini di tempat yang tenang, karena fitur ini sengaja mengabaikan Mode Senyap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascialo disattivato nei luoghi silenziosi: ignora di proposito la modalità silenziosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かな場所ではオフにしてください。サイレントモードをあえて無視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용한 곳에서는 꺼 두세요. 무음 모드를 일부러 무시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dette være av på stille steder – det overstyrer lydløs modus med vilje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet dit uit op stille plekken — het negeert de stille modus met opzet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W cichych miejscach zostaw to wyłączone – celowo ignoruje tryb cichy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe desativado em lugares silenciosos - ele ignora o modo silencioso de propósito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe desativado em locais silenciosos - ignora o modo silencioso de propósito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В тихих местах не включайте: он намеренно игнорирует бесшумный режим."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt det vara avstängt på tysta platser – det ignorerar ljudlöst läge med avsikt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดไว้เมื่ออยู่ในที่เงียบ เพราะตั้งใจให้ดังแม้อยู่ในโหมดเงียบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessiz yerlerde bunu kapalı tut; Sessiz Mod'u bilerek yok sayar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy tắt mục này ở nơi yên tĩnh - nó cố ý bỏ qua Chế độ im lặng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在安静的场合请关掉，它会故意无视静音模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
