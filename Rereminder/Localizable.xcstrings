    "tip_multidevice_message" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder funguje i na Apple Watch, ve widgetech, se Siri a na Macu. Klepnutím zjistíte jak."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder virker også på Apple Watch, i widgets, med Siri og på Mac. Tryk her for at se hvordan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder funktioniert auch auf Apple Watch, in Widgets, mit Siri und auf dem Mac. Tippe hier für mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Rereminder λειτουργεί και σε Apple Watch, γραφικά στοιχεία, Siri και Mac. Πατήστε εδώ για να δείτε πώς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder also works on Apple Watch, widgets, Siri, and Mac. Tap here to see how."
