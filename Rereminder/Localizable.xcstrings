    "You backed this app early. Anything we add to Pro from now on unlocks for you automatically — no extra purchase, ever." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast diese App früh unterstützt. Alles, was wir ab jetzt zu Pro hinzufügen, wird für dich automatisch freigeschaltet – ohne Zusatzkauf, für immer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apoyaste esta app desde el principio. Todo lo que agreguemos a Pro a partir de ahora se desbloqueará para ti automáticamente, sin compras extra, nunca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez soutenu cette app dès le début. Tout ce que nous ajouterons à Pro se débloquera automatiquement pour vous, sans aucun achat supplémentaire, jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai sostenuto questa app fin dall'inizio. Tutto ciò che aggiungeremo a Pro da ora in poi si sbloccherà per te automaticamente, senza mai altri acquisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリがまだ始まったばかりの頃に購入してくださいました。今後Proに何が追加されても自動的に解放されます — 追加購入は一切ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱이 막 시작할 때 값을 치러 주셨습니다. 앞으로 Pro에 무엇이 추가되든 자동으로 열립니다 — 추가 결제는 영원히 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você apoiou este app desde o início. Tudo o que adicionarmos ao Pro daqui em diante será desbloqueado automaticamente para você — sem nenhuma compra extra, nunca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在这个 App 刚起步时就付费支持。从今以后 Pro 增加的任何功能都会自动为你解锁 — 永远不需要再次付费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在這個 App 剛起步時就付費支持。從今以後 Pro 增加的任何功能都會自動為你解鎖 — 永遠不需要再次付費。"
          }
        }
      }
    },
