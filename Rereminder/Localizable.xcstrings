    "guide_watch_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spusťte, pozastavte nebo zastavte časovač na Apple Watch a iPhone se přizpůsobí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, sæt på pause eller stop på Apple Watch, så følger din iPhone med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte, pausiere oder stoppe auf der Apple Watch, und dein iPhone zieht mit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεκινήστε, παύστε ή σταματήστε στο Apple Watch και το iPhone ακολουθεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, pause, or stop on your Apple Watch and your iPhone follows."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, pause or stop on your Apple Watch and your iPhone follows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia, pausa o detén en el Apple Watch y el iPhone lo sigue."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistä, keskeytä tai pysäytä Apple Watchissa, niin iPhone seuraa mukana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez, mettez en pause ou arrêtez sur l’Apple Watch, et l’iPhone suit."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai, jeda, atau hentikan di Apple Watch, dan iPhone akan mengikuti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia, metti in pausa o ferma su Apple Watch e iPhone si adegua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watchで開始・一時停止・停止すると、iPhoneも連動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch에서 시작·일시정지·정지하면 iPhone도 따라갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, sett på pause eller stopp på Apple Watch, så følger iPhone etter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start, pauzeer of stop op je Apple Watch en je iPhone volgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamiaj, wstrzymuj i zatrzymuj na Apple Watch, a iPhone pójdzie w ślad."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie, pause ou pare no Apple Watch e o iPhone acompanha."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie, pause ou pare no Apple Watch e o iPhone acompanha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускайте, приостанавливайте и останавливайте таймер на Apple Watch — iPhone последует за ними."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta, pausa eller stoppa på Apple Watch så följer iPhone med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่ม หยุดชั่วคราว หรือหยุดบน Apple Watch แล้ว iPhone จะทำตาม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch'ta başlatın, duraklatın veya durdurun; iPhone da aynısını yapar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu, tạm dừng hoặc dừng trên Apple Watch và iPhone sẽ làm theo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple Watch 上开始、暂停或停止，iPhone 会随之同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple Watch 上開始、暫停或停止，iPhone 會跟著同步。"
          }
        }
      }
    },
