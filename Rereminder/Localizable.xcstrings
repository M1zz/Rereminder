        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seks sessioner, og den sidste får stadig sin tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sechs Sessions, und auch die letzte bekommt ihre Zeit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έξι συνεδρίες, και η τελευταία παίρνει κι αυτή τον χρόνο της."
