    "Swipe up or down to adjust the time. Double tap to enter an exact time." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejetím nahoru nebo dolů upravíte čas. Dvojitým klepnutím zadáte přesný čas."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stryg op eller ned for at justere tiden. Tryk to gange for at indtaste en præcis tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach oben oder unten wischen, um die Zeit anzupassen. Doppeltippen, um eine genaue Zeit einzugeben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώστε πάνω ή κάτω για να ρυθμίσετε τον χρόνο. Πατήστε δύο φορές για να εισαγάγετε ακριβή χρόνο."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe up or down to adjust the time. Double tap to enter an exact time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia arriba o abajo para ajustar el tiempo. Toca dos veces para escribir un tiempo exacto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä aikaa pyyhkäisemällä ylös tai alas. Syötä tarkka aika kaksoisnapauttamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le haut ou le bas pour régler la durée. Touchez deux fois pour saisir une durée précise."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser ke atas atau bawah untuk mengatur waktu. Ketuk dua kali untuk memasukkan waktu yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri in su o in giù per regolare il tempo. Tocca due volte per inserire un tempo preciso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下にスワイプして時間を調整します。ダブルタップで正確な時間を入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위아래로 쓸어넘겨 시간을 조절하세요. 두 번 탭하면 정확한 시간을 입력할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip opp eller ned for å justere tiden. Dobbelttrykk for å skrive inn en nøyaktig tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omhoog of omlaag om de tijd aan te passen. Tik dubbel om een exacte tijd in te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w górę lub w dół, aby zmienić czas. Stuknij dwukrotnie, aby wpisać dokładny czas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para cima ou para baixo para ajustar o tempo. Toque duas vezes para inserir um tempo exato."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para cima ou para baixo para ajustar o tempo. Toque duas vezes para introduzir um tempo exato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вверх или вниз, чтобы изменить время. Коснитесь дважды, чтобы ввести точное время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep uppåt eller nedåt för att justera tiden. Dubbeltryck för att ange en exakt tid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดขึ้นหรือลงเพื่อปรับเวลา แตะสองครั้งเพื่อป้อนเวลาที่แน่นอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süreyi ayarlamak için yukarı veya aşağı kaydır. Tam süre girmek için çift dokun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt lên hoặc xuống để chỉnh thời gian. Chạm hai lần để nhập thời gian chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下轻扫可调整时间。双点可输入精确时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下滑動可調整時間。點兩下可輸入精確時間。"
          }
        }
      }
    },
