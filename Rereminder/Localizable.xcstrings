    "When the timer ends" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když časovač skončí"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når timeren slutter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Timer endet"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν λήξει ο χρονομετρητής"
          }
        },
        "en-GB" : {
          "stringUnit" : {
