          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone이 없어도 Digital Crown으로 시간을 정하고 타이머를 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still inn varigheten med Digital Crown, og start en tidtaker uten at iPhonen er i nærheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel de duur in met de Digital Crown en start een timer, ook zonder je iPhone in de buurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw czas koronką Digital Crown i uruchom minutnik nawet bez iPhone’a w pobliżu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a duração com a Digital Crown e inicie um timer sem o iPhone por perto."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina a duração com a Digital Crown e inicie um temporizador sem o iPhone por perto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выставьте длительность колёсиком Digital Crown и запустите таймер, даже если iPhone далеко."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in längden med Digital Crown och starta en timer utan att ha din iPhone i närheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งระยะเวลาด้วย Digital Crown และเริ่มตัวจับเวลาได้แม้ไม่มี iPhone อยู่ใกล้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süreyi Digital Crown ile ayarla, iPhone'un yakında olmasa bile zamanlayıcıyı başlat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt thời lượng bằng Digital Crown và bắt đầu hẹn giờ mà không cần iPhone ở gần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用数码表冠设定时长，身边没有 iPhone 也能开始计时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用數位錶冠設定時長，身邊沒有 iPhone 也能開始計時。"
          }
        }
      }
    },
