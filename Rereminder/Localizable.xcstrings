    "guide_siri_f3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte akce Rereminderu do aplikace Zkratky a vytvořte si vlastní postupy a automatizace."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug Rereminder-handlinger i appen Genveje til at bygge dine egne rutiner og automatiseringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Rereminder-Aktionen in der Kurzbefehle-App für eigene Abläufe und Automationen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσθέστε ενέργειες του Rereminder στην εφαρμογή Συντομεύσεις για να φτιάξετε τις δικές σας ρουτίνες και αυτοματισμούς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop Rereminder actions into the Shortcuts app to build your own routines and automations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega acciones de Rereminder a la app Atajos para crear tus propias rutinas y automatizaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää Rereminderin toimintoja Pikakomennot-appiin ja rakenna omia rutiineja ja automaatioita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des actions Rereminder dans l’app Raccourcis pour créer vos propres routines et automatisations."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan tindakan Rereminder ke app Pintasan untuk membuat rutinitas dan otomatisasi Anda sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi le azioni di Rereminder all'app Comandi Rapidi per creare routine e automazioni tutte tue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットアプリに Rereminder のアクションを追加して、独自のルーティンや自動化を作成できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축어 앱에 두번알림 동작을 넣어 나만의 루틴과 자동화를 만들 수 있어요."
          }
        },
        "nb" : {
