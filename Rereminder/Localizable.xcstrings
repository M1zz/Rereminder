            "value" : "一次買斷，沒有訂閱費。"
          }
        }
      }
    },
    "Only basic notifications are supported on macOS" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter macOS werden nur einfache Mitteilungen unterstützt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En macOS solo se admiten notificaciones básicas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les notifications de base sont prises en charge sur macOS"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su macOS sono supportate solo le notifiche di base"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSでは基本的な通知のみ対応しています"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서는 기본 알림만 지원됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
