    "Open the Pro screen and restore your purchases, signed in to the Apple Account you bought with." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete obrazovku Pro a obnovte nákupy. Musíte být přihlášeni k Apple Accountu, kterým jste platili."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Pro-skærmen, og gendan dine køb, mens du er logget ind på den Apple-konto, du købte med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne den Pro-Bildschirm und stelle deine Käufe wieder her. Du musst mit dem Apple Account angemeldet sein, mit dem du gekauft hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε την οθόνη Pro και επαναφέρετε τις αγορές σας, συνδεδεμένοι με τον λογαριασμό Apple της αγοράς."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Pro screen and restore your purchases, signed in to the Apple Account you bought with."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la pantalla Pro y restaura tus compras con la sesión iniciada en la cuenta de Apple con la que compraste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Pro-näkymä ja palauta ostokset. Sinun on oltava kirjautuneena Apple-tilille, jolla ostit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l’écran Pro et restaurez vos achats, en étant connecté au compte Apple utilisé pour l’achat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka layar Pro dan pulihkan pembelian, dengan masuk ke Akun Apple yang dipakai saat membeli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri la schermata Pro e ripristina gli acquisti, con l’Apple Account usato per comprare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proの画面で購入を復元してください。購入に使ったApple Accountでサインインしている必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro 화면에서 구매를 복원하세요. 구매할 때 쓴 Apple 계정으로 로그인되어 있어야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne Pro-skjermen og gjenopprett kjøpene dine, pålogget Apple-kontoen du kjøpte med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open het Pro-scherm en herstel je aankopen terwijl je bent ingelogd met het Apple Account waarmee je kocht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz ekran Pro i przywróć zakupy, będąc zalogowanym na Apple Account użyte do zakupu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a tela Pro e restaure suas compras, conectado à Conta Apple usada na compra."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra o ecrã Pro e restaure as compras, com sessão iniciada na Conta Apple usada na compra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте экран Pro и восстановите покупки, войдя в Apple Account, с которого совершена покупка."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Pro-skärmen och återställ dina köp, inloggad på det Apple-konto du köpte med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดหน้าจอ Pro แล้วกู้คืนรายการที่ซื้อ โดยลงชื่อเข้าด้วยบัญชี Apple ที่ใช้ซื้อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro ekranını açın ve satın alımlarınızı geri yükleyin; satın alırken kullandığınız Apple Hesabı ile oturum açmış olun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở màn hình Pro và khôi phục giao dịch mua, khi đã đăng nhập Tài khoản Apple dùng để mua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 Pro 页面恢复购买，并确保已登录购买时使用的 Apple 账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 Pro 畫面回復購買，並確認已登入購買時使用的 Apple 帳號。"
          }
        }
      }
    },
