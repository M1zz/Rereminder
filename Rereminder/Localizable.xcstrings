    },
    "If it still doesn't connect, check that Bluetooth and Wi-Fi are on for both devices." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud se stále nepřipojí, zkontrolujte, že je na obou zařízeních zapnuté Bluetooth i Wi‑Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis den stadig ikke forbinder, så tjek, at Bluetooth og Wi-Fi er slået til på begge enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls es immer noch nicht klappt, prüfe, ob Bluetooth und WLAN auf beiden Geräten aktiviert sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν εξακολουθεί να μη συνδέεται, ελέγξτε ότι το Bluetooth και το Wi-Fi είναι ενεργά και στις δύο συσκευές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aún no se conecta, comprueba que Bluetooth y Wi-Fi estén activados en ambos dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos yhteys ei vieläkään toimi, tarkista, että Bluetooth ja Wi-Fi ovat päällä molemmissa laitteissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la connexion échoue encore, vérifiez que le Bluetooth et le Wi-Fi sont activés sur les deux appareils."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika masih belum terhubung, pastikan Bluetooth dan Wi-Fi aktif di kedua perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ancora non si collega, verifica che Bluetooth e Wi-Fi siano attivi su entrambi i dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それでも接続できない場合は、両方のデバイスのBluetoothとWi‑Fiがオンか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그래도 연결되지 않으면 두 기기의 Bluetooth와 Wi-Fi가 켜져 있는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis det fortsatt ikke kobler til, sjekk at Bluetooth og Wi-Fi er på på begge enhetene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukt het nog steeds niet? Controleer dan of Bluetooth en wifi op beide apparaten aanstaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli nadal nie ma połączenia, sprawdź, czy Bluetooth i Wi‑Fi są włączone na obu urządzeniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ainda não conectar, verifique se o Bluetooth e o Wi-Fi estão ativados nos dois dispositivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mesmo assim não ligar, verifique se o Bluetooth e o Wi-Fi estão ativados nos dois dispositivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если подключиться всё ещё не удаётся, проверьте, что Bluetooth и Wi‑Fi включены на обоих устройствах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om det fortfarande inte ansluter, kontrollera att Bluetooth och Wi-Fi är på i båda enheterna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากยังเชื่อมต่อไม่ได้ ให้ตรวจสอบว่าเปิดบลูทูธและ Wi-Fi บนทั้งสองอุปกรณ์แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hâlâ bağlanmıyorsa iki aygıtta da Bluetooth ve Wi-Fi'ın açık olduğunu kontrol et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu vẫn không kết nối được, hãy kiểm tra Bluetooth và Wi-Fi đã bật trên cả hai thiết bị chưa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果还是连不上，请确认两台设备的蓝牙和 Wi-Fi 都已打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果還是連不上，請確認兩台裝置的藍牙和 Wi-Fi 都已開啟。"
          }
        }
      }
    },
    "If you do, Rereminder can show the remaining time in your Mac menu bar." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud ano, Rereminder může zobrazovat zbývající čas v řádku nabídek na Macu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så kan Rereminder vise den resterende tid i menulinjen på din Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann kann Rereminder die Restzeit in der Menüleiste deines Macs anzeigen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν έχετε, το Rereminder μπορεί να δείχνει τον χρόνο που απομένει στη γραμμή μενού του Mac."
