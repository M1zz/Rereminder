    "Nothing has been removed. You can keep only the essentials on the main screen and bring the rest back anytime in Settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nebylo odstraněno. Na hlavní obrazovce můžete nechat jen to nejdůležitější a zbytek kdykoli vrátit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet er fjernet. Du kan nøjes med det vigtigste på hovedskærmen og hente resten tilbage når som helst i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde nichts entfernt. Du kannst auf dem Hauptbildschirm nur das Wichtigste behalten und den Rest jederzeit in den Einstellungen zurückholen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν αφαιρέθηκε τίποτα. Μπορείτε να κρατήσετε μόνο τα βασικά στην κύρια οθόνη και να επαναφέρετε τα υπόλοιπα όποτε θέλετε από τις Ρυθμίσεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing has been removed. You can keep only the essentials on the main screen and bring the rest back anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha eliminado nada. Puedes dejar solo lo esencial en la pantalla principal y recuperar el resto cuando quieras en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään ei ole poistettu. Voit pitää päänäytöllä vain olennaisen ja palauttaa loput milloin tahansa kohdasta Asetukset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n'a été supprimé. Vous pouvez ne garder que l'essentiel sur l'écran principal et retrouver le reste à tout moment dans Réglages."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang dihapus. Anda bisa menyimpan yang penting saja di layar utama dan mengembalikan sisanya kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato rimosso nulla. Puoi tenere solo l'essenziale nella schermata principale e riportare il resto quando vuoi da Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なくなった機能はありません。メイン画面には必要なものだけを置き、残りは設定からいつでも戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "없어진 기능은 없습니다. 메인 화면에는 꼭 필요한 것만 두고, 나머지는 설정에서 언제든 다시 꺼낼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting er fjernet. Du kan beholde bare det viktigste på hovedskjermen og hente resten tilbake når som helst i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is niets verwijderd. Je kunt alleen het belangrijkste op het hoofdscherm houden en de rest altijd terughalen via Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie zostało usunięte. Na ekranie głównym możesz zostawić tylko to, co najważniejsze, a resztę przywrócić w każdej chwili w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi removido. Você pode deixar só o essencial na tela principal e trazer o resto de volta quando quiser em Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi removido. Pode deixar apenas o essencial no ecrã principal e recuperar o resto quando quiser em Definições."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не удалено. На главном экране можно оставить только самое нужное, а остальное вернуть в любой момент в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget har tagits bort. Du kan behålla bara det viktigaste på huvudskärmen och hämta tillbaka resten när som helst i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีสิ่งใดถูกนำออก คุณเก็บเฉพาะสิ่งจำเป็นไว้บนหน้าจอหลัก และเรียกส่วนที่เหลือกลับมาได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir şey kaldırılmadı. Ana ekranda yalnızca gerekli olanları tutabilir, gerisini istediğiniz zaman Ayarlar'dan geri getirebilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có gì bị gỡ bỏ. Bạn có thể chỉ giữ những gì cần thiết trên màn hình chính và lấy lại phần còn lại bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有移除任何功能。主屏幕可以只保留必要内容，其余内容随时可在设置中恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有移除任何功能。主畫面可以只保留必要內容，其餘內容隨時可在設定中恢復。"
          }
        }
      }
    },
