    "guide_widget_f3_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Live-Countdown auf dem Sperrbildschirm und in der Dynamic Island hat Tasten für Pause, Fortsetzen und Stopp."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The live countdown on your Lock Screen and Dynamic Island has Pause, Resume, and Stop buttons built in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo en vivo de la pantalla bloqueada y la Dynamic Island incluye botones para pausar, reanudar y detener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte à rebours en direct sur l’écran verrouillé et la Dynamic Island intègre les boutons Pause, Reprendre et Arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il conto alla rovescia in tempo reale sulla schermata di blocco e in Dynamic Island ha i pulsanti Pausa, Riprendi e Stop integrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面と Dynamic Island のリアルタイムカウントダウンに一時停止・再開・停止ボタンがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면과 다이나믹 아일랜드의 실시간 카운트다운에 일시정지·재개·정지 버튼이 들어 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A contagem ao vivo na Tela Bloqueada e na Dynamic Island já vem com os botões Pausar, Retomar e Parar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定屏幕和灵动岛上的实时倒计时内置了暂停、继续和停止按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鎖定畫面和動態島上的即時倒數計時內建了暫停、繼續和停止按鈕。"
          }
        }
      }
    },
