    "guide_mac_f1_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh den Countdown in der Menüleiste und pausiere, setze fort oder stoppe, ohne deine Arbeit zu verlassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch the countdown in the menu bar and pause, resume, or stop without leaving your work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira el tiempo restante en la barra de menús y pausa, reanuda o detén sin dejar lo que estás haciendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez le compte à rebours dans la barre des menus et mettez en pause, reprenez ou arrêtez sans quitter votre travail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda il conto alla rovescia nella barra dei menu e metti in pausa, riprendi o ferma senza lasciare il lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーで残り時間を見ながら、作業を中断せずに一時停止・再開・停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대에서 남은 시간을 보고 작업을 멈추지 않고 일시정지·재개·정지하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe a contagem na barra de menus e pause, retome ou pare sem sair do que está fazendo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在菜单栏看剩余时间，不用离开手上的工作就能暂停、继续或停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在選單列看剩餘時間，不用離開手上的工作就能暫停、繼續或停止。"
          }
        }
      }
    },
