    "guide_footer_note" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt über iCloud synchron – deine Timer begleiten dich von Gerät zu Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything stays in sync through iCloud, so your timers follow you from device to device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se mantiene sincronizado con iCloud, así que tus temporizadores te siguen de un dispositivo a otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste synchronisé via iCloud : vos minuteurs vous suivent d’un appareil à l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta sincronizzato tramite iCloud, così i tuoi timer ti seguono da un dispositivo all'altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべて iCloud で同期されるので、タイマーはデバイスをまたいで引き継がれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 정보가 iCloud로 동기화되어 타이머가 기기를 따라 이동합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica sincronizado pelo iCloud, então seus timers acompanham você de um dispositivo para outro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有信息都通过 iCloud 同步，计时器会跟着你在设备之间流转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有資訊都透過 iCloud 同步，計時器會跟著你在裝置之間移動。"
          }
        }
      }
    },
    "guide_header_subtitle" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder läuft auf iPhone, Apple Watch, in Widgets, mit Siri und auf dem Mac. So holst du das Beste aus jedem Gerät heraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder works across iPhone, Apple Watch, widgets, Siri, and Mac. Here's how to get the most out of each one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder funciona en iPhone, Apple Watch, widgets, Siri y Mac. Así puedes sacarle el máximo partido a cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder fonctionne sur iPhone, Apple Watch, les widgets, Siri et Mac. Voici comment tirer le meilleur de chacun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder funziona su iPhone, Apple Watch, widget, Siri e Mac. Ecco come sfruttare al meglio ognuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminderは iPhone、Apple Watch、ウィジェット、Siri、Mac で使えます。それぞれの活用方法を紹介します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두번알림은 iPhone, Apple Watch, 위젯, Siri, Mac에서 함께 동작합니다. 각 기기에서 어떻게 활용하는지 알려드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rereminder funciona no iPhone, no Apple Watch, em widgets, com a Siri e no Mac. Veja como aproveitar cada um ao máximo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder 可以在 iPhone、Apple Watch、小组件、Siri 和 Mac 上一起使用。下面介绍每种设备的用法。"
          }
        },
        "zh-Hant" : {
