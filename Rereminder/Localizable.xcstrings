    "Saving it means one tap to start next time." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když ho uložíte, příště ho spustíte jedním klepnutím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemmer du den, kan du starte med ét tryk næste gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesichert heißt: nächstes Mal mit einem Tipp starten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν το αποθηκεύσετε, την επόμενη φορά ξεκινά με ένα άγγιγμα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saving it means one tap to start next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo guardas, la próxima vez empiezas con un toque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallentamalla käynnistät sen ensi kerralla yhdellä napautuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré, il suffira d’un toucher pour le relancer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau disimpan, lain kali cukup sekali ketuk untuk mulai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvandolo, la prossima volta ti basta un tocco per iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存しておけば、次回はワンタップで始められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장해 두면 다음엔 한 번만 눌러서 시작할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagrer du det, kan du starte med ett trykk neste gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar je hem, dan start je de volgende keer met één tik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapisaniu następnym razem wystarczy jedno stuknięcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvando, da próxima vez basta um toque para começar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardar, da próxima vez basta um toque para começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните — и в следующий раз запуск в одно касание."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sparar du det räcker ett tryck för att starta nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกไว้ ครั้งหน้าแตะเดียวก็เริ่มได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydedersen bir dahaki sefere tek dokunuşla başlarsın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu lại thì lần sau chỉ cần một chạm để bắt đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存下来，下次点一下就能开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儲存下來，下次點一下就能開始。"
          }
        }
      }
    },
    "Screens rearrange neatly when you make text bigger, with nothing cut off." : {
      "comment" : "Roadmap item detail: larger text",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když zvětšíte písmo, obrazovka se úhledně přeskládá a nic se neusekne."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gør teksten større, omarrangeres skærmen pænt, uden at noget bliver skåret af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei größerer Schrift ordnen sich die Bildschirme sauber neu an, ohne dass etwas abgeschnitten wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μεγαλώνετε το κείμενο, η οθόνη αναδιατάσσεται χωρίς να κόβεται τίποτα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly when you make text bigger, with nothing cut off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aumentar el tamaño del texto, la pantalla se reorganiza sin cortar nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun suurennat tekstiä, näkymä järjestyy siististi uudelleen eikä mitään leikkaudu pois."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous agrandissez le texte, l'écran se réorganise proprement, sans rien couper."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat teks diperbesar, layar menata ulang dengan rapi tanpa ada yang terpotong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ingrandisci il testo, lo schermo si riorganizza senza tagliare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても切れることなく、見やすく配置し直されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gjør teksten større, ordner skjermen seg pent på nytt uten at noe blir kuttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de tekst groter maakt, wordt het scherm netjes opnieuw ingedeeld zonder dat er iets wegvalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po powiększeniu tekstu ekran układa się na nowo i nic nie jest ucinane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o texto, a tela se reorganiza sem cortar nada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o texto, o ecrã reorganiza-se sem cortar nada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При увеличении шрифта экран аккуратно перестраивается, ничего не обрезается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du gör texten större ordnas skärmen om snyggt utan att något klipps av."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายตัวอักษร หน้าจอจะจัดวางใหม่อย่างเรียบร้อยโดยไม่มีส่วนใดถูกตัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
