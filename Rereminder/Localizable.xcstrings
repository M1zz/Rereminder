    "guide_iphone_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge den Fortschritt in Widgets auf Home- und Sperrbildschirm oder starte und stoppe mit einem Tippen im Kontrollzentrum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check progress from Home and Lock Screen widgets, or start and stop with a single tap from Control Center."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta el progreso en los widgets de la pantalla de inicio y de la pantalla bloqueada, o inicia y detén con un toque desde el Centro de control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez la progression depuis les widgets de l’écran d’accueil et de l’écran verrouillé, ou lancez et arrêtez d’un seul toucher depuis le centre de contrôle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla l'avanzamento dai widget della schermata Home e della schermata di blocco, oppure avvia e ferma con un tocco da Centro di Controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面やロック画面のウィジェットで進行状況を確認したり、コントロールセンターからワンタップで開始・停止できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈·잠금 화면 위젯으로 진행 상황을 확인하거나 제어 센터에서 한 번에 시작·정지하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o progresso nos widgets da Tela de Início e da Tela Bloqueada, ou inicie e pare com um toque na Central de Controle."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用主屏幕和锁定屏幕小组件查看进度，或在控制中心一点即可开始与停止。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
