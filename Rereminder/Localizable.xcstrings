    "guide_siri_f2_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenne eine bestimmte Dauer, etwa „Starte einen 5-Minuten-Timer“, und er beginnt sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask for a specific length, like “Start a 5 minute timer,” and it begins right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide una duración concreta, como “Inicia un temporizador de 5 minutos”, y empieza al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez une durée précise, comme « Lance un minuteur de 5 minutes », et il démarre aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi una durata precisa, come “Avvia un timer di 5 minuti”, e parte subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「5分タイマーを開始」のように時間を指定するとすぐに始まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“5분 타이머 시작”처럼 원하는 시간을 말하면 바로 시작됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça uma duração específica, como “Iniciar um timer de 5 minutos”, e ele começa na hora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说出想要的时长，比如“开始 5 分钟计时”，就会立刻开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說出想要的時長，例如「開始 5 分鐘計時」，就會立刻開始。"
          }
        }
      }
    },
