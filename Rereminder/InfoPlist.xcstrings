    "NSAlarmKitUsageDescription" : {
      "comment" : "Shown when the app asks to schedule alarms (설정 > 알림 > 끝나면 알람으로 울리기)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Rereminder المنبّهات لتعرف بانتهاء المؤقت حتى في الوضع الصامت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder používá budíky, aby vás konec časovače zastihl i v tichém režimu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder bruger alarmer, så slutningen på en timer kan nå dig, selv i lydløs tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder nutzt Alarme, damit dich das Ende eines Timers auch im Stumm-Modus erreicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Rereminder χρησιμοποιεί ξυπνητήρια ώστε η λήξη ενός χρονομετρητή να σας ειδοποιεί ακόμα και σε Αθόρυβη λειτουργία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder uses alarms so the end of a timer can wake you even in Silent Mode."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder uses alarms so the end of a timer can wake you even in Silent Mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder usa alarmas para que el final de un temporizador pueda avisarte incluso en modo silencio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder käyttää hälytyksiä, jotta ajastimen loppu tavoittaa sinut myös Äänettömässä tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder utilise les alarmes pour que la fin d’un minuteur puisse vous alerter, même en mode silencieux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder memakai alarm agar akhir timer tetap bisa membangunkan Anda, bahkan dalam Mode Senyap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder usa le sveglie così la fine di un timer può avvisarti anche in modalità silenziosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイレントモードでもタイマーの終了に気づけるよう、アラームを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무음 모드에서도 타이머가 끝난 것을 알 수 있도록 알람을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder bruker alarmer slik at slutten på en tidtaker kan nå deg selv i lydløs modus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder gebruikt alarmen zodat het einde van een timer je ook in stille modus bereikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder używa alarmów, aby koniec minutnika dotarł do Ciebie nawet w trybie cichym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rereminder usa alarmes para que o fim de um timer chame sua atenção mesmo no modo silencioso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rereminder usa alarmes para que o fim de um temporizador o possa alertar mesmo no modo silencioso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder использует будильник, чтобы конец таймера разбудил вас даже в бесшумном режиме."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder använder alarm så att slutet på en timer kan väcka dig även i ljudlöst läge."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder ใช้การปลุกเพื่อให้การจบของตัวจับเวลาปลุกคุณได้ แม้อยู่ในโหมดเงียบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder, zamanlayıcının bitişi Sessiz Mod'dayken bile seni uyarabilsin diye alarmları kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder dùng báo thức để lúc hẹn giờ kết thúc vẫn báo được cho bạn, kể cả ở Chế độ im lặng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder 使用闹钟，让计时结束时即使在静音模式下也能叫醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder 使用鬧鐘，讓計時結束時即使在靜音模式下也能叫醒你。"
          }
        }
      }
    },
    "NSHomeKitUsageDescription" : {
      "comment" : "Shown when the app asks for Home access (설정 > 알림 > 조명으로 알리기)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر Rereminder لون الأضواء التي تختارها عندما يرن تنبيه المؤقت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder mění barvu vybraných světel, když zazní upozornění časovače."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder skifter farven på de lamper, du vælger, når en timerpåmindelse lyder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder ändert die Farbe der ausgewählten Lampen, wenn eine Timer-Erinnerung ertönt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Rereminder αλλάζει το χρώμα των φώτων που επιλέγετε όταν χτυπά μια ειδοποίηση χρονομέτρου."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder changes the colour of the lights you choose when a timer alert rings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder cambia el color de las luces que elijas cuando suena un aviso del temporizador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder vaihtaa valitsemiesi valojen väriä, kun ajastimen muistutus soi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder change la couleur des lumières choisies quand une alerte du minuteur sonne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder mengubah warna lampu yang Anda pilih saat pengingat timer berbunyi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder cambia il colore delle luci che scegli quando suona un avviso del timer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマーの通知が鳴ったときに、選んだ照明の色を変えるためにホームデータを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머 알림이 울릴 때 고른 조명의 색을 바꾸기 위해 홈 데이터에 접근합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder endrer fargen på lysene du velger når et timervarsel ringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder verandert de kleur van de gekozen lampen als er een timermelding klinkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder zmienia kolor wybranych świateł, gdy rozlegnie się alert minutnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rereminder muda a cor das luzes que você escolher quando um alerta do timer tocar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rereminder muda a cor das luzes que escolher quando um alerta do temporizador toca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder меняет цвет выбранных светильников, когда звучит сигнал таймера."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder ändrar färgen på lamporna du väljer när en timerpåminnelse ljuder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder จะเปลี่ยนสีไฟที่คุณเลือกเมื่อการแจ้งเตือนของตัวจับเวลาดัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder, bir zamanlayıcı uyarısı çaldığında seçtiğiniz ışıkların rengini değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder đổi màu các đèn bạn chọn khi lời nhắc hẹn giờ reo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "计时器提醒响起时，Rereminder 会更改你所选灯光的颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計時器提醒響起時，Rereminder 會變更你所選燈光的顏色。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
