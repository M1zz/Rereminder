    "NSAlarmKitUsageDescription" : {
      "comment" : "Shown when the app asks to schedule alarms (설정 > 알림 > 끝나면 알람으로 울리기)",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder používá budíky, aby vás konec časovače zastihl i v tichém režimu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder bruger alarmer, så slutningen på en timer kan nå dig, selv i lydløs tilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder nutzt Alarme, damit dich das Ende eines Timers auch im Stumm-Modus erreicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Rereminder χρησιμοποιεί ξυπνητήρια ώστε η λήξη ενός χρονομετρητή να σας ειδοποιεί ακόμα και σε Αθόρυβη λειτουργία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder uses alarms so the end of a timer can wake you even in Silent Mode."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder uses alarms so the end of a timer can wake you even in Silent Mode."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder usa alarmas para que el final de un temporizador pueda avisarte incluso en modo silencio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder käyttää hälytyksiä, jotta ajastimen loppu tavoittaa sinut myös Äänettömässä tilassa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder utilise les alarmes pour que la fin d’un minuteur puisse vous alerter, même en mode silencieux."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder memakai alarm agar akhir timer tetap bisa membangunkan Anda, bahkan dalam Mode Senyap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder usa le sveglie così la fine di un timer può avvisarti anche in modalità silenziosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイレントモードでもタイマーの終了に気づけるよう、アラームを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무음 모드에서도 타이머가 끝난 것을 알 수 있도록 알람을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder bruker alarmer slik at slutten på en tidtaker kan nå deg selv i lydløs modus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder gebruikt alarmen zodat het einde van een timer je ook in stille modus bereikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder używa alarmów, aby koniec minutnika dotarł do Ciebie nawet w trybie cichym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rereminder usa alarmes para que o fim de um timer chame sua atenção mesmo no modo silencioso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Rereminder usa alarmes para que o fim de um temporizador o possa alertar mesmo no modo silencioso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder использует будильник, чтобы конец таймера разбудил вас даже в бесшумном режиме."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder använder alarm så att slutet på en timer kan väcka dig även i ljudlöst läge."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder ใช้การปลุกเพื่อให้การจบของตัวจับเวลาปลุกคุณได้ แม้อยู่ในโหมดเงียบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder, zamanlayıcının bitişi Sessiz Mod'dayken bile seni uyarabilsin diye alarmları kullanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder dùng báo thức để lúc hẹn giờ kết thúc vẫn báo được cho bạn, kể cả ở Chế độ im lặng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder 使用闹钟，让计时结束时即使在静音模式下也能叫醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rereminder 使用鬧鐘，讓計時結束時即使在靜音模式下也能叫醒你。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
